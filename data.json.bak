\"pinned\": true\n            }\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"audits\",\n      \"bn\": \"অডিট\",\n      \"en\": \"Audits\",\n      \"icon\": \"⚖\",\n      \"view\": {\n        \"type\": \"audits\"\n      },\n      \"children\": [\n        {\n          \"id\": \"a-pass\",\n          \"bn\": \"উত্তীর্ণ\",\n          \"en\": \"Pass\",\n          \"view\": {\n            \"type\": \"audits\",\n            \"filter\": {\n              \"result\": \"pass\"\n            }\n          }\n        },\n        {\n          \"id\": \"a-warn\",\n          \"bn\": \"সতর্কতা\",\n          \"en\": \"Warning\",\n          \"view\": {\n            \"type\": \"audits\",\n            \"filter\": {\n              \"result\": \"warning\"\n            }\n          }\n        },\n        {\n          \"id\": \"a-fail\",\n          \"bn\": \"ব্যর্থ\",\n          \"en\": \"Fail\",\n          \"view\": {\n            \"type\": \"audits\",\n            \"filter\": {\n              \"result\": \"fail\"\n            }\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"codecraft\",\n      \"bn\": \"কোডক্রাফ্ট\",\n      \"en\": \"CodeCraft\",\n      \"icon\": \"❮❯\",\n      \"open\": true,\n      \"view\": {\n        \"type\": \"codes\"\n      },\n      \"children\": []\n    },\n    {\n      \"id\": \"registry\",\n      \"bn\": \"রেজিস্ট্রি (সব)\",\n      \"en\": \"Registry (all)\",\n      \"icon\": \"☰\",\n      \"view\": {\n        \"type\": \"all\"\n      }\n    }\n  ],\n  \"tasks\": [\n    {\n      \"id\": \"TSK-2026-0001\",\n      \"title\": \"Set up project registry\",\n      \"title_bn\": \"প্রজেক্ট রেজিস্ট্রি সেটআপ\",\n      \"desc\": \"Create index.html, data.json and scripts.\",\n      \"status\": \"done\",\n      \"priority\": \"high\",\n      \"due\": \"\",\n      \"category\": \"setup\",\n      \"tags\": [\n        \"setup\"\n      ],\n      \"created_at\": \"2026-09-24T09:00:00+06:00\",\n      \"completed_at\": \"2026-09-24T10:00:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:00:00+06:00\",\n          \"event\": \"created\"\n        },\n        {\n          \"at\": \"2026-09-24T10:00:00+06:00\",\n          \"event\": \"status → done\",\n          \"note\": \"\"\n        }\n      ]\n    },\n    {\n      \"id\": \"TSK-2026-0002\",\n      \"title\": \"Add logo to assets/\",\n      \"title_bn\": \"assets/ এ লোগো যুক্ত করুন\",\n      \"desc\": \"Place logo.png inside assets folder.\",\n      \"status\": \"todo\",\n      \"priority\": \"urgent\",\n      \"due\": \"2026-09-30\",\n      \"category\": \"setup\",\n      \"tags\": [\n        \"logo\"\n      ],\n      \"created_at\": \"2026-09-24T09:05:00+06:00\",\n      \"completed_at\": \"\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:05:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    },\n    {\n      \"id\": \"TSK-2026-0003\",\n      \"title\": \"Review weekly entries\",\n      \"title_bn\": \"সাপ্তাহিক এন্ট্রি পর্যালোচনা\",\n      \"desc\": \"\",\n      \"status\": \"doing\",\n      \"priority\": \"medium\",\n      \"due\": \"2026-10-01\",\n      \"category\": \"review\",\n      \"tags\": [\n        \"weekly\"\n      ],\n      \"created_at\": \"2026-09-24T09:10:00+06:00\",\n      \"completed_at\": \"\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:10:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    }\n  ],\n  \"notes\": [\n    {\n      \"id\": \"NOT-2026-0001\",\n      \"title\": \"How this system works\",\n      \"title_bn\": \"এই সিস্টেম যেভাবে কাজ করে\",\n      \"body\": \"index.html never changes. Add data with the scripts; the page reads data.json.\",\n      \"category\": \"guide\",\n      \"tags\": [\n        \"guide\"\n      ],\n      \"pinned\": true,\n      \"created_at\": \"2026-09-24T09:15:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:15:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    },\n    {\n      \"id\": \"NOT-2026-0002\",\n      \"title\": \"ID format\",\n      \"title_bn\": \"আইডি ফরম্যাট\",\n      \"body\": \"TSK / NOT / AUD + year + serial. IDs are never reused.\",\n      \"category\": \"guide\",\n      \"tags\": [\n        \"id\"\n      ],\n      \"pinned\": false,\n      \"created_at\": \"2026-09-24T09:20:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:20:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    }\n  ],\n  \"audits\": [\n    {\n      \"id\": \"AUD-2026-0001\",\n      \"title\": \"Data integrity check\",\n      \"title_bn\": \"ডাটা ইন্টিগ্রিটি যাচাই\",\n      \"result\": \"pass\",\n      \"target\": \"data.json\",\n      \"findings\": \"No duplicate IDs.\",\n      \"auditor\": \"MJ Ahmad\",\n      \"related\": [\n        \"TSK-2026-0001\"\n      ],\n      \"category\": \"system\",\n      \"tags\": [\n        \"integrity\"\n      ],\n      \"created_at\": \"2026-09-24T10:10:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T10:10:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    },\n    {\n      \"id\": \"AUD-2026-0002\",\n      \"title\": \"Logo file present\",\n      \"title_bn\": \"লোগো ফাইল আছে কিনা\",\n      \"result\": \"warning\",\n      \"target\": \"assets/logo.png\",\n      \"findings\": \"Logo not yet added.\",\n      \"auditor\": \"MJ Ahmad\",\n      \"related\": [\n        \"TSK-2026-0002\"\n      ],\n      \"category\": \"system\",\n      \"tags\": [\n        \"logo\"\n      ],\n      \"created_at\": \"2026-09-24T10:12:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T10:12:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    }\n  ],\n  \"codes\": []\n}\n```\n\n---\n\n`index.html` ও `data.json` আপডেট করেছি। আপনার `data.json`-এ নিজের এন্ট্রি থাকলে সরাসরি রিপ্লেস করবেন না, শুধু `index.html` বদলান এবং নিচের `meta` অংশটুকু আপনার `data.json`-এ যোগ করুন। JavaScript-এর সিনট্যাক্স ও `validate.py` যাচাই করেছি, কিন্তু ব্রাউজারে খুলে দেখিনি। `assets/logo.png` আমার এখানে নেই, তাই লোগো আপনার লোকালে দেখে নিন।\n\n1. **লোগো:** \"M\" ফ্যালব্যাক পুরোপুরি বাদ। হেডার ও স্প্ল্যাশ দুই জায়গায় সরাসরি `meta.logo` (`assets/logo.png`) লিংক থেকে লোগো লোড হয়।\n2. **EN | BN টগল:** হেডারে বোতাম যোগ হয়েছে, ডিফল্ট EN। BN বেছে নিলে মেনু, ড্যাশবোর্ড, স্ট্যাটাস, ফিল্টার, বিস্তারিত প্যানেল, ফুটার, তারিখ ও শিরোনাম (`title_bn` থাকলে) বাংলায় দেখায়। পছন্দ মনে থাকে, পরের বার খুললে একই ভাষা থাকবে।\n3. **ফুটার:** সেখানে আপনার চলমান প্রজেক্ট, ওয়েবসাইট, ইমেইল ও লিংকডিনের লিংক আছে। এর নিচে \"Quick commands & emergency help\" ভাঁজ করা অংশে সব শেল কমান্ড আছে। কমান্ডে ক্লিক করলে কপি হয়। জরুরি অবস্থায় `data.json.bak` থেকে ফেরত আনার কমান্ডও আছে।\n4. **ট্যাগলাইন:** আপনার লাইনটি স্প্ল্যাশ স্ক্রিন ও ফুটারে বসিয়েছি।\n\nফুটারের লিংক, কমান্ড ও ট্যাগলাইন সবই `data.json`-এর `meta.links`, `meta.commands` ও `meta.tagline` থেকে আসে। ভবিষ্যতে এগুলো বদলাতে শুধু `data.json` এডিট করলেই হবে, `index.html` ছুঁতে হবে না।\n\n---\n\n## V1.2\n\n`add_task.py`\n```\n#!/usr/bin/env python3\n\"\"\"python3 add_task.py \"Title\" [--bn \"শিরোনাম\"] [--desc ..] [--priority low|medium|high|urgent] [--due YYYY-MM-DD] [--category ..] [--tags a,b]\"\"\"\nimport argparse\nfrom _lib import *\na = argparse.ArgumentParser()\na.add_argument(\"title\", nargs=\"?\", default=\"\"); a.add_argument(\"--bn\", default=\"\"); a.add_argument(\"--desc\", default=\"\")\na.add_argument(\"--priority\", default=\"medium\", choices=[\"low\", \"medium\", \"high\", \"urgent\"])\na.add_argument(\"--due\", default=\"\"); a.add_argument(\"--category\", default=\"general\"); a.add_argument(\"--tags\", default=\"\")\nx = a.parse_args()\nif not x.title:\n    print(\"— New task (Enter to skip optional fields) —\")\n    x.title = ask(\"Title (EN) *\", req=True); x.bn = ask(\"শিরোনাম (BN)\"); x.desc = ask(\"Description\")\n    x.priority = ask(\"Priority low/medium/high/urgent\", \"medium\", choices=[\"low\", \"medium\", \"high\", \"urgent\"])\n    x.due = ask(\"Due YYYY-MM-DD\"); x.category = ask(\"Category\", \"general\"); x.tags = ask(\"Tags a,b\")\nd = load(); i = next_id(d, \"task\")\nd[\"tasks\"].append({\"id\": i, \"title\": x.title, \"title_bn\": x.bn, \"desc\": x.desc, \"status\": \"todo\",\n  \"priority\": x.priority, \"due\": x.due, \"category\": x.category, \"tags\": tags(x.tags),\n  \"created_at\": now(), \"completed_at\": \"\", \"history\": [{\"at\": now(), \"event\": \"created\"}]})\nsave(d); print(\"✔ Task added:\", i)\n```\n\n---\n\n`add_note.py`\n```\n#!/usr/bin/env python3\n\"\"\"python3 add_note.py \"Title\" [--bn ..] [--body ..] [--category ..] [--tags a,b] [--pinned]\"\"\"\nimport argparse\nfrom _lib import *\na = argparse.ArgumentParser()\na.add_argument(\"title\", nargs=\"?\", default=\"\"); a.add_argument(\"--bn\", default=\"\"); a.add_argument(\"--body\", default=\"\")\na.add_argument(\"--category\", default=\"general\"); a.add_argument(\"--tags\", default=\"\"); a.add_argument(\"--pinned\", action=\"store_true\")\nx = a.parse_args()\nif not x.title:\n    print(\"— New note (Enter to skip optional fields) —\")\n    x.title = ask(\"Title (EN) *\", req=True); x.bn = ask(\"শিরোনাম (BN)\"); x.body = ask(\"Body\")\n    x.category = ask(\"Category\", \"general\"); x.tags = ask(\"Tags a,b\"); x.pinned = ask(\"Pin? y/n\", \"n\", choices=[\"y\", \"n\"]) == \"y\"\nd = load(); i = next_id(d, \"note\")\nd[\"notes\"].append({\"id\": i, \"title\": x.title, \"title_bn\": x.bn, \"body\": x.body, \"category\": x.category,\n  \"tags\": tags(x.tags), \"pinned\": x.pinned, \"created_at\": now(), \"history\": [{\"at\": now(), \"event\": \"created\"}]})\nsave(d); print(\"✔ Note added:\", i)\n```\n\n---\n\n`add_audit.py`\n```\n#!/usr/bin/env python3\n\"\"\"python3 add_audit.py \"Title\" --result pass|warning|fail [--target ..] [--findings ..] [--auditor ..] [--related TSK-2026-0001,NOT-..] [--bn ..] [--category ..] [--tags ..]\"\"\"\nimport argparse\nfrom _lib import *\na = argparse.ArgumentParser()\na.add_argument(\"title\", nargs=\"?\", default=\"\"); a.add_argument(\"--bn\", default=\"\"); a.add_argument(\"--result\", default=\"\", choices=[\"pass\", \"warning\", \"fail\"])\na.add_argument(\"--target\", default=\"\"); a.add_argument(\"--findings\", default=\"\"); a.add_argument(\"--auditor\", default=\"\")\na.add_argument(\"--related\", default=\"\"); a.add_argument(\"--category\", default=\"general\"); a.add_argument(\"--tags\", default=\"\")\nx = a.parse_args()\nif not x.title:\n    print(\"— New audit (Enter to skip optional fields) —\")\n    x.title = ask(\"Title (EN) *\", req=True); x.bn = ask(\"শিরোনাম (BN)\")\n    x.result = ask(\"Result pass/warning/fail *\", req=True, choices=[\"pass\", \"warning\", \"fail\"])\n    x.target = ask(\"Target\"); x.findings = ask(\"Findings\"); x.auditor = ask(\"Auditor\", \"MJ Ahmad\")\n    x.related = ask(\"Related IDs a,b\"); x.category = ask(\"Category\", \"general\"); x.tags = ask(\"Tags a,b\")\nif not x.result: die(\"--result is required (pass|warning|fail)\")\nd = load()\nfor r in tags(x.related):\n    if find(d, r)[0] is None: die(f\"related ID not found: {r}\")\ni = next_id(d, \"audit\")\nd[\"audits\"].append({\"id\": i, \"title\": x.title, \"title_bn\": x.bn, \"result\": x.result, \"target\": x.target,\n  \"findings\": x.findings, \"auditor\": x.auditor, \"related\": tags(x.related), \"category\": x.category,\n  \"tags\": tags(x.tags), \"created_at\": now(), \"history\": [{\"at\": now(), \"event\": \"created\"}]})\nsave(d); print(\"✔ Audit added:\", i)\n```\n\n---\n\n`complete_task.py`\n```\n#!/usr/bin/env python3\n\"\"\"python3 complete_task.py TSK-2026-0001 [--note \"...\"] [--status doing|done|todo]\"\"\"\nimport argparse\nfrom _lib import *\na = argparse.ArgumentParser(); a.add_argument(\"id\", nargs=\"?\", default=\"\"); a.add_argument(\"--note\", default=\"\")\na.add_argument(\"--status\", default=\"done\", choices=[\"todo\", \"doing\", \"done\"])\nx = a.parse_args(); d = load()\nif not x.id:\n    for t in d[\"tasks\"]:\n        if t[\"status\"] != \"done\": print(f'  {t[\"id\"]}  [{t[\"status\"]}]  {t[\"title\"]}')\n    x.id = ask(\"Task ID *\", req=True); x.note = ask(\"Note\"); k, t = find(d, x.id)\nif k != \"task\": die(f\"task not found: {x.id}\")\nt[\"status\"] = x.status; t[\"completed_at\"] = now() if x.status == \"done\" else \"\"\nt[\"history\"].append({\"at\": now(), \"event\": \"status → \" + x.status, \"note\": x.note})\nsave(d); print(f\"✔ {x.id} → {x.status}\")\n```\n\n---\n\n`_lib.py`\n```\n#!/usr/bin/env python3\n\"\"\"Shared helpers: load/save data.json safely, unique IDs, history log.\"\"\"\nimport json, os, shutil, sys\nfrom datetime import datetime\nHERE = os.path.dirname(os.path.abspath(__file__))\nDATA = os.path.join(HERE, \"data.json\")\nKIND = {\"task\": (\"TSK\", \"tasks\"), \"note\": (\"NOT\", \"notes\"), \"audit\": (\"AUD\", \"audits\"), \"code\": (\"CDE\", \"codes\")}\n\ndef now(): return datetime.now().astimezone().isoformat(timespec=\"seconds\")\n\ndef load():\n    with open(DATA, encoding=\"utf-8\") as f: d = json.load(f)\n    d.setdefault(\"codes\", []); return d\n\ndef save(d):\n    d[\"meta\"][\"updated_at\"] = now()\n    if os.path.exists(DATA): shutil.copy(DATA, DATA + \".bak\")\n    tmp = DATA + \".tmp\"\n    with open(tmp, \"w\", encoding=\"utf-8\") as f:\n        json.dump(d, f, ensure_ascii=False, indent=2)\n    os.replace(tmp, DATA)\n\ndef next_id(d, kind):\n    \"\"\"Never reuses an ID: PREFIX-YYYY-NNNN, counter kept per kind & year.\"\"\"\n    p, _ = KIND[kind]; y = datetime.now().year\n    c = d[\"meta\"].setdefault(\"counters\", {}).setdefault(kind, {})\n    c[str(y)] = c.get(str(y), 0) + 1\n    return f\"{p}-{y}-{c[str(y)]:04d}\"\n\ndef find(d, id_):\n    for k, (p, key) in KIND.items():\n        for it in d[key]:\n            if it[\"id\"] == id_: return k, it\n    return None, None\n\ndef tags(s): return [t.strip() for t in (s or \"\").split(\",\") if t.strip()]\n\ndef die(msg): print(\"ERROR:\", msg, file=sys.stderr); sys.exit(1)\n\ndef ask(label, default=\"\", req=False, choices=None):\n    \"\"\"Interactive prompt used when a script runs without arguments.\"\"\"\n    while True:\n        v = input(f\"{label}{' ['+default+']' if default else ''}: \").strip() or default\n        if req and not v: print(\"  required\"); continue\n        if choices and v not in choices: print(\"  choose:\", \"/\".join(choices)); continue\n        return v\n\nimport hashlib\nEXT = {\"html\":(\"html\",\"HTML\"),\"htm\":(\"html\",\"HTML\"),\"json\":(\"json\",\"JSON\"),\"py\":(\"python\",\"Python\"),\n \"js\":(\"node\",\"Node.js\"),\"mjs\":(\"node\",\"Node.js\"),\"cjs\":(\"node\",\"Node.js\"),\"ts\":(\"ts\",\"TypeScript\"),\n \"jsx\":(\"react\",\"React\"),\"tsx\":(\"react\",\"React\"),\"sh\":(\"shell\",\"Shell\"),\"bash\":(\"shell\",\"Shell\"),\n \"css\":(\"css\",\"CSS\"),\"md\":(\"markdown\",\"Markdown\"),\"yml\":(\"yaml\",\"YAML\"),\"yaml\":(\"yaml\",\"YAML\"),\n \"sql\":(\"sql\",\"SQL\"),\"xml\":(\"xml\",\"XML\"),\"php\":(\"php\",\"PHP\"),\"java\":(\"java\",\"Java\"),\"c\":(\"c\",\"C\"),\n \"cpp\":(\"cpp\",\"C++\"),\"go\":(\"go\",\"Go\"),\"rs\":(\"rust\",\"Rust\"),\"txt\":(\"text\",\"Text\")}\nSHEBANG = {\"python\":(\"python\",\"Python\"),\"node\":(\"node\",\"Node.js\"),\"bash\":(\"shell\",\"Shell\"),\"sh\":(\"shell\",\"Shell\")}\n\ndef detect(name, text, force=\"\"):\n    if force:\n        return next((v for v in EXT.values() if v[0] == force), (force, force.upper()))\n    ext = name.rsplit(\".\", 1)[-1].lower() if \".\" in name else \"\"\n    if ext in EXT: return EXT[ext]\n    if text.startswith(\"#!\"):\n        for k, v in SHEBANG.items():\n            if k in text.split(\"\\n\", 1)[0]: return v\n    return (\"text\", \"Text\")\n\nimport re\ndef walk(ns, path=()):\n    for n in ns:\n        yield n, path + (n[\"id\"],)\n        yield from walk(n.get(\"children\", []), path + (n[\"id\"],))\n\ndef find_node(d, ref):\n    \"\"\"ref = menu id, or a label path like 'CodeCraft/Web/Portal' (EN/BN/id, case-insensitive). -> (node, [id path]) or (None, None)\"\"\"\n    ref = ref.strip()\n    for n, p in walk(d[\"menu\"]):\n        if n[\"id\"] == ref: return n, list(p)\n    segs = [s.strip().lower() for s in ref.strip(\"/\").split(\"/\") if s.strip()]\n    if not segs: return None, None\n    def go(ns, sg, path):\n        for n in ns:\n            if sg[0] in (n[\"id\"].lower(), (n.get(\"en\") or \"\").lower(), (n.get(\"bn\") or \"\").lower()):\n                if len(sg) == 1: return n, path + [n[\"id\"]]\n                r = go(n.get(\"children\", []), sg[1:], path + [n[\"id\"]])\n                if r[0]: return r\n        return None, None\n    r = go(d[\"menu\"], segs, [])\n    if r[0]: return r\n    root = next((n for n in d[\"menu\"] if n[\"id\"] == \"codecraft\"), None)   # 'Web/Portal' means CodeCraft/Web/Portal\n    return go(root.get(\"children\", []), segs, [\"codecraft\"]) if root else (None, None)\n\ndef ensure_root(d):\n    root = next((n for n in d[\"menu\"] if n[\"id\"] == \"codecraft\"), None)\n    if not root:\n        root = {\"id\": \"codecraft\", \"bn\": \"কোডক্রাফ্ট\", \"en\": \"CodeCraft\", \"icon\": \"❮❯\", \"open\": True, \"view\": {\"type\": \"codes\"}, \"children\": []}\n        k = next((j for j, n in enumerate(d[\"menu\"]) if n[\"id\"] == \"registry\"), len(d[\"menu\"])); d[\"menu\"].insert(k, root)\n    root.setdefault(\"children\", []); return root\n\ndef ensure_chain(d, parent, ppath, names, bns=()):\n    \"\"\"Create (or reuse, matched by name) nested submenus under parent. -> (deepest node, id path)\"\"\"\n    ids = {n[\"id\"] for n, _ in walk(d[\"menu\"])}\n    for k, name in enumerate(names):\n        sib = parent.setdefault(\"children\", [])\n        hit = next((c for c in sib if name.lower() in ((c.get(\"en\") or \"\").lower(), (c.get(\"bn\") or \"\").lower())), None)\n        if not hit:\n            bn = bns[k].strip() if k < len(bns) and bns[k].strip() else name\n            base = \"c-\" + (re.sub(r\"[^a-z0-9]+\", \"-\", name.lower()).strip(\"-\") or \"m\"); nid = base; i = 2\n            while nid in ids: nid = f\"{base}-{i}\"; i += 1\n            ids.add(nid)\n            hit = {\"id\": nid, \"bn\": bn, \"en\": name, \"view\": {\"type\": \"codes\", \"filter\": {\"menu_path\": nid}}}\n            sib.append(hit)\n        parent = hit; ppath = ppath + [hit[\"id\"]]\n    return parent, ppath\n\ndef normalize(d):\n    \"\"\"Upgrade older data: language nodes filter by menu_path; entries get a menu_path.\"\"\"\n    root = ensure_root(d)\n    for c in root[\"children\"]:\n        f = c.get(\"view\", {}).get(\"filter\", {})\n        if \"lang\" in f: c[\"view\"][\"filter\"] = {\"menu_path\": c[\"id\"]}\n    for it in d[\"codes\"]:\n        it.setdefault(\"menu_path\", [\"codecraft\", \"c-\" + it[\"lang\"]])\n    return d\n```\n\n---\n\nএটা কোনো ত্রুটি নয়। আমার ডিজাইনে `title` বাধ্যতামূলক আর্গুমেন্ট ছিল, আর আপনি কোনো শিরোনাম না দিয়ে চালিয়েছেন। তবে আপনি প্রশ্নোত্তর ধরনের ইন্টারঅ্যাকটিভ মোড আশা করেছিলেন বলে মনে হচ্ছে, তাই সেটা যোগ করে দিয়েছি।\n\nএখন আর্গুমেন্ট ছাড়া চালালে একটি একটি করে জিজ্ঞেস করবে। ঐচ্ছিক ঘরে শুধু Enter চাপলেই হয়:\n\n```\n./add_task.py        # শিরোনাম (EN/BN), বিবরণ, অগ্রাধিকার, শেষ তারিখ, বিভাগ, ট্যাগ\n./add_note.py        # শিরোনাম, বিবরণ, বিভাগ, ট্যাগ, পিন\n./add_audit.py       # শিরোনাম, ফলাফল, লক্ষ্য, পর্যবেক্ষণ, অডিটর, সম্পর্কিত আইডি\n./complete_task.py   # খোলা টাস্কের তালিকা দেখিয়ে আইডি চাইবে\n```\n\nএকবারে দিতে চাইলে আগের মতোই চলবে:\n\n```\n./add_task.py \"Fix login\" --bn \"লগইন ঠিক করা\" --priority high --due 2026-10-05\n```\n\nআপডেট হয়েছে `_lib.py`, `add_task.py`, `add_note.py`, `add_audit.py` ও `complete_task.py`। এই পাঁচটি ফাইল আপনার ফোল্ডারে রিপ্লেস করুন, `data.json` ছোঁয়ার দরকার নেই। প্রতিটি রান শেষে `./run.sh check` চালিয়ে ডাটা যাচাই করে নিতে পারেন।\n\n---\n\n## V1.3\n\n*CodeCraft*\n\n`index.html`\n```\n<!DOCTYPE html>\n<html lang=\"bn\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>MJ Ahmad — Registry</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--bg:#F3F5F2;--pan:#FFFFFF;--ink:#16211E;--mut:#5F6E69;--line:#D9DFDB;--pine:#0F4C42;--brass:#B8862B;--ok:#2E7D4F;--warn:#B8862B;--bad:#B3412E;--sel:#E3EEEA;--r:6px}\n@media(prefers-color-scheme:dark){:root{--bg:#0F1514;--pan:#161E1C;--ink:#E6ECE9;--mut:#93A29C;--line:#26332F;--pine:#5FB59F;--brass:#D4A74A;--ok:#5DB985;--warn:#D4A74A;--bad:#E1705B;--sel:#1E2D29}}\n*{box-sizing:border-box;margin:0}\nhtml,body{height:100%}\nbody{font-family:\"Hind Siliguri\",\"Noto Sans Bengali\",system-ui,sans-serif;background:var(--bg);color:var(--ink);display:flex;flex-direction:column;font-size:15px;line-height:1.5}\n:focus-visible{outline:2px solid var(--brass);outline-offset:2px}\n#splash{position:fixed;inset:0;z-index:99;background:var(--pine);color:#F3F5F2;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;cursor:pointer;transition:opacity .5s}\n#splash.out{opacity:0;pointer-events:none}\n#splash img{width:96px;height:96px;object-fit:contain}\n#splash h1{font-size:34px;font-weight:700;letter-spacing:.5px}\n#splash p{opacity:.8}\n#splash i{display:block;height:2px;width:0;background:var(--brass);animation:bar var(--ms,1.8s) linear forwards}\n@keyframes bar{to{width:180px}}\nheader{display:flex;align-items:center;gap:12px;padding:10px 16px;background:var(--pine);color:#F3F5F2;flex:none}\nheader img{width:36px;height:36px;object-fit:contain}\nheader h1{font-size:18px;font-weight:700;line-height:1.2}\nheader small{display:block;opacity:.8;font-size:12px}\n#q{margin-left:auto;width:min(320px,45%);padding:7px 10px;border-radius:var(--r);border:1px solid #ffffff44;background:#ffffff1c;color:#fff;font:inherit}\n#q::placeholder{color:#ffffffaa}\n#burger{display:none;background:none;border:0;color:#fff;font-size:22px}\n.main{flex:1;display:flex;min-height:0}\nnav{width:290px;flex:none;overflow:auto;background:var(--pan);border-right:1px solid var(--line);padding:10px 6px}\nnav ul{list-style:none;padding:0}\nnav ul ul{margin-left:14px;border-left:1px solid var(--line);padding-left:4px}\n.node{display:flex;align-items:center;gap:6px;padding:6px 8px;border-radius:var(--r);cursor:pointer;user-select:none}\n.node:hover{background:var(--sel)}\n.node.act{background:var(--sel);color:var(--pine);font-weight:600;box-shadow:inset 3px 0 var(--brass)}\n.chev{width:16px;text-align:center;color:var(--mut);transition:transform .15s;flex:none}\n.open>.node .chev{transform:rotate(90deg)}\nnav li>ul{display:none}nav li.open>ul{display:block}\n.ic{width:18px;text-align:center;flex:none}\n.lb{flex:1;min-width:0}.lb small{display:block;color:var(--mut);font-size:11.5px;line-height:1.2;font-weight:400}\n.cnt{font-size:11.5px;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:0 7px;color:var(--mut)}\nsection#view{flex:1;overflow:auto;padding:20px 24px}\nh2{font-size:22px;margin-bottom:2px}.sub{color:var(--mut);margin-bottom:14px}\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:22px}\n.stat{background:var(--pan);border:1px solid var(--line);border-radius:var(--r);padding:12px;cursor:pointer}\n.stat b{font-size:28px;display:block;line-height:1.1}.stat span{color:var(--mut);font-size:13px}\n.stat.bad b{color:var(--bad)}\n.bar{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}\n.chip{border:1px solid var(--line);background:var(--pan);color:var(--ink);border-radius:16px;padding:2px 12px;font:inherit;font-size:13px;cursor:pointer}\n.chip.on{background:var(--pine);color:#fff;border-color:var(--pine)}\n.row{display:grid;grid-template-columns:132px 1fr auto;gap:12px;align-items:center;background:var(--pan);border:1px solid var(--line);border-radius:var(--r);padding:9px 12px;margin-bottom:6px;cursor:pointer}\n.row:hover{border-color:var(--pine)}\n.id{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;color:var(--pine)}\n.tt small{display:block;color:var(--mut);font-size:12.5px}\n.b{display:inline-block;font-size:12px;border-radius:4px;padding:0 7px;border:1px solid var(--line);margin-left:4px;white-space:nowrap}\n.b.todo,.b.low,.b.pass{color:var(--ok)}.b.doing,.b.medium,.b.warning{color:var(--warn)}.b.high,.b.urgent,.b.fail{color:var(--bad)}.b.done{color:var(--mut)}\n.empty{padding:40px 0;color:var(--mut);text-align:center}\n#modal{position:fixed;inset:0;background:#0008;display:none;z-index:50;justify-content:flex-end}\n#modal.on{display:flex}\n#modal .p{width:min(520px,100%);background:var(--pan);height:100%;overflow:auto;padding:22px}\n#modal dl{display:grid;grid-template-columns:110px 1fr;gap:6px 10px;margin:14px 0}\n#modal dt{color:var(--mut)}#modal dd{margin:0;word-break:break-word}\n#modal .lnk{color:var(--pine);cursor:pointer;text-decoration:underline;font-family:ui-monospace,monospace;font-size:13px;margin-right:8px}\n.hist{border-left:2px solid var(--line);padding-left:12px;margin-top:8px;font-size:13px;color:var(--mut)}\n.hist div{margin-bottom:6px}\n.x{float:right;background:none;border:0;font-size:22px;color:var(--mut);cursor:pointer}\nfooter{flex:none;padding:8px 16px;background:var(--pan);border-top:1px solid var(--line);color:var(--mut);font-size:12.5px;display:flex;flex-wrap:wrap;gap:6px 18px;justify-content:space-between}\n@media(max-width:820px){#burger{display:block}nav{position:fixed;top:56px;bottom:0;left:0;z-index:40;transform:translateX(-100%);transition:transform .2s;width:290px}nav.on{transform:none}.row{grid-template-columns:1fr}section#view{padding:14px}}\n.lang{display:flex;border:1px solid #ffffff55;border-radius:var(--r);overflow:hidden;flex:none}\n.lang button{background:none;border:0;color:#fff;padding:5px 11px;font:inherit;font-size:13px;font-weight:600;cursor:pointer;opacity:.75}\n.lang button+button{border-left:1px solid #ffffff55}\n.lang button.on{background:var(--brass);opacity:1}\n#splash .tg{font-style:italic;max-width:420px;text-align:center;font-size:13px;opacity:.65;padding:0 20px}\nfooter{gap:8px;flex-direction:column;align-items:stretch;max-height:45vh;overflow:auto}\nfooter a{color:var(--pine);text-decoration:none;font-weight:500}footer a:hover{text-decoration:underline}\n.fl{display:flex;flex-wrap:wrap;gap:6px 20px}\nfooter summary{cursor:pointer;color:var(--ink);font-weight:500}\n.cm{display:grid;grid-template-columns:200px 1fr;gap:4px 12px;padding:4px 0;border-bottom:1px dashed var(--line)}\n.cm code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;color:var(--pine);cursor:pointer;word-break:break-all}\n.fq{font-style:italic;color:var(--ink)}\n@media(max-width:820px){.cm{grid-template-columns:1fr}#q{width:34%}}\n.lg{background:var(--lc,#6B7B76);color:#fff;font-size:12px;font-weight:700;border-radius:4px;padding:1px 8px;letter-spacing:.4px;white-space:nowrap;align-self:flex-start}\n.row .lg{margin-left:4px}\n.l-html{--lc:#D8552B}.l-json{--lc:#A38F1A}.l-python{--lc:#3776AB}.l-node{--lc:#3F8A36}.l-shell{--lc:#3E8E3E}.l-css{--lc:#2965F1}.l-ts{--lc:#3178C6}.l-react{--lc:#1F8EA8}.l-markdown{--lc:#5B6B8C}.l-sql{--lc:#8A5AA8}\n.cc{background:var(--pan);border:1px solid var(--line);border-left:4px solid var(--lc,#6B7B76);border-radius:var(--r);margin-bottom:14px;overflow:hidden}\n.cch{display:flex;gap:12px;align-items:flex-start;padding:10px 12px}\n.ct{flex:1;min-width:0}.ct small{display:block;color:var(--mut)}\n.ca{display:flex;gap:6px}\n.ca button,.tg2{border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:var(--r);padding:3px 12px;font:inherit;font-size:13px;cursor:pointer}\n.ca button:hover,.tg2:hover{border-color:var(--pine);color:var(--pine)}\n.tg2{margin:8px 12px 10px}\n.cb{display:flex;background:#0F1917;color:#D8E4DF;font:12.5px/1.6 ui-monospace,Menlo,Consolas,monospace;overflow:auto;position:relative;max-height:70vh}\n.cb pre{margin:0}.cb .gt{padding:10px 10px 10px 12px;color:#5F7A72;text-align:right;user-select:none;border-right:1px solid #ffffff14;position:sticky;left:0;background:#0F1917}\n.cb .cd{padding:10px 14px;flex:1;min-width:0;tab-size:2}\n.cc.fade .cb{cursor:pointer;overflow:hidden}.cc.fade .cb::after{content:\"\";position:absolute;left:0;right:0;bottom:0;height:30px;background:linear-gradient(transparent,#0F1917)}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;animation-duration:.01s!important}}\n</style>\n</head>\n<body>\n<div id=\"splash\"><img id=\"sl\" alt=\"Logo\"><h1 id=\"st\">MJ Ahmad</h1><p id=\"ss\"></p><p id=\"sq\" class=\"tg\"></p><i></i></div>\n<header>\n  <button id=\"burger\" aria-label=\"Menu\">☰</button>\n  <img id=\"hl\" alt=\"Logo\">\n  <div><h1 id=\"ht\">MJ Ahmad</h1><small id=\"hs\"></small></div>\n  <input id=\"q\" type=\"search\" placeholder=\"খুঁজুন / Search — ID, শিরোনাম, ট্যাগ…\" aria-label=\"Search\">\n  <div class=\"lang\" id=\"lang\" role=\"group\" aria-label=\"Language\"><button data-l=\"en\">EN</button><button data-l=\"bn\">BN</button></div>\n</header>\n<div class=\"main\"><nav id=\"nav\" aria-label=\"Menu\"></nav><section id=\"view\"></section></div>\n<footer><div class=\"fl\" id=\"fl\"></div><details id=\"fd\"><summary id=\"fs\"></summary><div id=\"fc\"></div></details><div class=\"fq\" id=\"fq\"></div><div class=\"fm\" id=\"f2\"></div></footer>\n<div id=\"modal\"><div class=\"p\" id=\"mp\"></div></div>\n<script>\nconst $=s=>document.querySelector(s),E=(t,c,h)=>{const e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e};\nconst esc=s=>String(s??'').replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]));\nconst UI={\nen:{search:'Search — ID, title, tag…',dash:'Dashboard',recent:'Recent',searchT:'Search',all:'All',empty:'Nothing here yet. Add entries with ./run.sh',overdue:'Overdue',history:'History',copy:'copy',openT:'Open tasks',done:'Done',notes:'Notes',audits:'Audits',failed:'Failed audits',t:'tasks',n:'notes',a:'audits',upd:'Updated',cmds:'Quick commands & emergency help',err:'Could not load data.json. Run ./run.sh serve and open http://localhost:8000',menu:'Menu',codes:'CodeCraft',cp:'Copy',cpd:'Copied ✓',dl:'Download',sa:'Show all',co:'Collapse',ln:'lines',\n st:{todo:'To do',doing:'In progress',done:'Done',low:'Low',medium:'Medium',high:'High',urgent:'Urgent',pass:'Pass',warning:'Warning',fail:'Fail'},\n ty:{tasks:'Tasks',notes:'Notes',audits:'Audits',all:'Registry',codes:'CodeCraft'},\n fk:{status:'Status',priority:'Priority',due:'Due',category:'Category',tags:'Tags',created_at:'Created',completed_at:'Completed',desc:'Description',body:'Note',result:'Result',target:'Target',findings:'Findings',auditor:'Auditor',related:'Related',pinned:'Pinned',filename:'File',source:'Source',lang_label:'Type',lines:'Lines',bytes:'Size (bytes)'}},\nbn:{search:'খুঁজুন — আইডি, শিরোনাম, ট্যাগ…',dash:'ড্যাশবোর্ড',recent:'সাম্প্রতিক',searchT:'অনুসন্ধান',all:'সব',empty:'এখনো কিছু নেই। ./run.sh দিয়ে যুক্ত করুন',overdue:'মেয়াদোত্তীর্ণ',history:'ইতিহাস',copy:'কপি',openT:'খোলা টাস্ক',done:'সম্পন্ন',notes:'নোট',audits:'অডিট',failed:'ব্যর্থ অডিট',t:'টাস্ক',n:'নোট',a:'অডিট',upd:'আপডেট',cmds:'দ্রুত কমান্ড ও জরুরি নির্দেশনা',err:'data.json লোড হয়নি। ./run.sh serve চালিয়ে http://localhost:8000 খুলুন',menu:'মেনু',codes:'কোডক্রাফ্ট',cp:'কপি',cpd:'কপি হয়েছে ✓',dl:'ডাউনলোড',sa:'সবটুকু দেখুন',co:'গুটিয়ে নিন',ln:'লাইন',\n st:{todo:'করণীয়',doing:'চলমান',done:'সম্পন্ন',low:'নিম্ন',medium:'মাঝারি',high:'উচ্চ',urgent:'জরুরি',pass:'উত্তীর্ণ',warning:'সতর্কতা',fail:'ব্যর্থ'},\n ty:{tasks:'টাস্ক',notes:'নোট',audits:'অডিট',all:'রেজিস্ট্রি',codes:'কোডক্রাফ্ট'},\n fk:{status:'অবস্থা',priority:'অগ্রাধিকার',due:'শেষ তারিখ',category:'বিভাগ',tags:'ট্যাগ',created_at:'তৈরি',completed_at:'সম্পন্ন হয়েছে',desc:'বিবরণ',body:'নোট',result:'ফলাফল',target:'লক্ষ্য',findings:'পর্যবেক্ষণ',auditor:'অডিটর',related:'সম্পর্কিত',pinned:'পিন করা',filename:'ফাইল',source:'উৎস',lang_label:'ধরন',lines:'লাইন',bytes:'আকার (বাইট)'}}};\nlet D,lang='en',cur={type:'dashboard'},curId='dash',open=new Set(),sf='',search='',mId='';\ntry{const s=localStorage.getItem('mj_lang');if(s==='bn'||s==='en')lang=s}catch(e){}\nconst T=()=>UI[lang],pick=(en,bn)=>lang==='bn'?(bn||en):(en||bn),lab=n=>pick(n.en,n.bn),ttl=i=>pick(i.title,i.title_bn);\nconst items=t=>t==='all'?[...D.tasks.map(x=>({...x,_k:'tasks'})),...D.notes.map(x=>({...x,_k:'notes'})),...D.audits.map(x=>({...x,_k:'audits'})),...(D.codes||[]).map(x=>({...x,_k:'codes',menu_path:x.menu_path||['codecraft','c-'+x.lang]}))]:(D[t]||[]).map(x=>({...x,_k:t}));\nconst match=(it,f)=>!f||Object.entries(f).every(([k,v])=>Array.isArray(it[k])?it[k].includes(v):it[k]===v);\nconst cnt=v=>v&&v.type!=='dashboard'?items(v.type).filter(i=>match(i,v.filter)).length:null;\nconst fmt=s=>s?new Date(s).toLocaleString(lang==='bn'?'bn-BD':'en-GB',{dateStyle:'medium',timeStyle:'short'}):'—';\nconst overdue=t=>t.status!=='done'&&t.due&&t.due<new Date().toISOString().slice(0,10);\n\nfetch('data.json?'+Date.now()).then(r=>r.json()).then(init).catch(e=>{$('#view').innerHTML='<div class=\"empty\">'+esc(T().err)+'<br><small>'+esc(e)+'</small></div>';hideSplash()});\n\nfunction init(d){\n  D=d;const m=d.meta;\n  $('#hl').src=$('#sl').src=m.logo;\n  (function pre(ns){ns.forEach(n=>{if(n.open)open.add(n.id);pre(n.children||[])})})(D.menu);\n  $('#splash').style.setProperty('--ms',(m.splash_ms||1800)+'ms');\n  document.querySelectorAll('#lang button').forEach(b=>b.onclick=()=>{lang=b.dataset.l;try{localStorage.setItem('mj_lang',lang)}catch(e){}applyLang()});\n  applyLang();\n  if(location.hash.length>1)showM(location.hash.slice(1));\n  setTimeout(hideSplash,m.splash_ms||1800);\n}\nfunction applyLang(){\n  const m=D.meta,t=T(),sub=pick(m.subtitle_en,m.subtitle_bn);\n  document.documentElement.lang=lang;document.title=m.title+' — '+sub;\n  $('#ht').textContent=$('#st').textContent=m.title;$('#hs').textContent=$('#ss').textContent=sub;\n  $('#sq').textContent=m.tagline||'';$('#q').placeholder=t.search;\n  document.querySelectorAll('#lang button').forEach(b=>b.classList.toggle('on',b.dataset.l===lang));\n  drawNav();drawFooter();render();if($('#modal').classList.contains('on'))showM(mId)}\nfunction hideSplash(){$('#splash').classList.add('out')}\n$('#splash').onclick=hideSplash;\n$('#burger').onclick=()=>$('#nav').classList.toggle('on');\n$('#q').oninput=e=>{search=e.target.value.trim().toLowerCase();render()};\n$('#modal').onclick=e=>{if(e.target.id==='modal')closeM()};\naddEventListener('keydown',e=>{if(e.key==='Escape')closeM()});\n\nfunction drawFooter(){\n  const m=D.meta,t=T();\n  $('#fl').innerHTML=(m.links||[]).map(l=>`<a href=\"${esc(l.url)}\"${l.url.startsWith('mailto:')?'':' target=\"_blank\" rel=\"noopener\"'}><span>${esc(l.icon||'')}</span> ${esc(pick(l.en,l.bn))}</a>`).join('');\n  const c=m.commands||[];$('#fd').hidden=!c.length;$('#fs').textContent=t.cmds;\n  $('#fc').innerHTML=c.map(x=>`<div class=\"cm\"><span>${esc(pick(x.en,x.bn))}</span><code title=\"click to copy\">${esc(x.cmd)}</code></div>`).join('');\n  $('#fc').querySelectorAll('code').forEach(e=>e.onclick=()=>navigator.clipboard&&navigator.clipboard.writeText(e.textContent));\n  $('#fq').textContent=m.tagline?'“'+m.tagline+'”':'';\n  $('#f2').textContent=`${pick(m.footer_en,m.footer_bn)} · v${m.version} · ${D.tasks.length} ${t.t} · ${D.notes.length} ${t.n} · ${D.audits.length} ${t.a} · ${(D.codes||[]).length} ${t.codes} · ${t.upd} ${fmt(m.updated_at)} · © ${new Date().getFullYear()} ${m.title}`}\n\nfunction drawNav(){const nav=$('#nav');nav.innerHTML='';nav.append(tree(D.menu))}\nfunction tree(ns){\n  const ul=E('ul');\n  ns.forEach(n=>{\n    const li=E('li',open.has(n.id)?'open':''),kids=n.children&&n.children.length,c=cnt(n.view);\n    const row=E('div','node'+(n.id===curId?' act':''));\n    row.innerHTML=`<span class=\"chev\">${kids?'›':''}</span><span class=\"ic\">${n.icon||''}</span><span class=\"lb\">${esc(lab(n))}</span>${c!=null?`<span class=\"cnt\">${c}</span>`:''}`;\n    row.tabIndex=0;\n    const go=()=>{if(kids){open.has(n.id)?open.delete(n.id):open.add(n.id)}if(n.view){cur=n.view;curId=n.id;sf='';$('#nav').classList.remove('on')}drawNav();render()};\n    row.onclick=go;row.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go()}};\n    li.append(row);if(kids)li.append(tree(n.children));ul.append(li)});\n  return ul}\n\nfunction render(){\n  const v=$('#view');v.innerHTML='';\n  if(search){list(v,'all',null,true);return}\n  cur.type==='dashboard'?dash(v):list(v,cur.type,cur.filter)}\n\nfunction dash(v){\n  const t=T(),TK=D.tasks,A=D.audits;\n  v.innerHTML=`<h2>${t.dash}</h2>`;\n  const g=E('div','grid');\n  [[t.openT,TK.filter(x=>x.status!=='done').length,'tasks',{}],[t.done,TK.filter(x=>x.status==='done').length,'tasks',{status:'done'}],[t.overdue,TK.filter(overdue).length,'tasks',{},'bad'],[t.notes,D.notes.length,'notes',{}],[t.audits,A.length,'audits',{}],[t.failed,A.filter(a=>a.result==='fail').length,'audits',{result:'fail'},'bad'],[t.codes,(D.codes||[]).length,'codes',{}]]\n   .forEach(([l,n,ty,f,c])=>{const s=E('div','stat '+(c||''),`<b>${n}</b><span>${l}</span>`);s.onclick=()=>{cur={type:ty,filter:f};curId='';drawNav();render()};g.append(s)});\n  v.append(g,E('h2','',t.recent));\n  items('all').sort((a,b)=>b.created_at.localeCompare(a.created_at)).slice(0,8).forEach(i=>v.append(row(i)))}\n\nfunction list(v,type,filter,isSearch){\n  const t=T();\n  const nm=isSearch?null:nodeMap()[curId];\n  v.append(E('h2','',isSearch?t.searchT:(nm&&nm.view&&nm.view.type===type?lab(nm):t.ty[type])));\n  if(nm&&nm.view&&nm.view.filter&&nm.view.filter.menu_path)v.append(E('div','sub','📁 '+esc(crumb(pathOf(nm.view.filter.menu_path)))));\n  if(nm&&nm.children&&nm.children.length){const b=E('div','bar');nm.children.forEach(c=>{const n=cnt(c.view),ch=E('button','chip',esc(lab(c))+(n!=null?` (${n})`:''));ch.onclick=()=>{open.add(nm.id);if(c.view){cur=c.view;curId=c.id;sf=''}drawNav();render()};b.append(ch)});v.append(b)}\n  if(isSearch)v.append(E('div','sub','“'+esc(search)+'”'));\n  let arr=items(type).filter(i=>match(i,filter)).filter(i=>!search||[i.id,i.title,i.title_bn,i.desc,i.body,i.findings,i.desc_bn,i.filename,i.content,i.category,(i.tags||[]).join(' ')].join(' ').toLowerCase().includes(search));\n  const sts=[...new Set(arr.map(i=>i.status||i.result).filter(Boolean))];\n  if(sts.length>1){const b=E('div','bar');['',...sts].forEach(s=>{const c=E('button','chip'+(sf===s?' on':''),s?t.st[s]||s:t.all);c.onclick=()=>{sf=s;render()};b.append(c)});v.append(b)}\n  arr=arr.filter(i=>!sf||(i.status||i.result)===sf).sort((a,b)=>b.id.localeCompare(a.id));\n  if(!arr.length)v.append(E('div','empty',t.empty));\n  arr.forEach(i=>v.append(type==='codes'&&!isSearch?codeCard(i):row(i)))}\n\nconst nodeMap=()=>{const m={};(function w(ns){ns.forEach(n=>{m[n.id]=n;w(n.children||[])})})(D.menu);return m};\nfunction pathOf(id){let r=null;(function w(ns,p){ns.forEach(n=>{const q=[...p,n.id];if(n.id===id)r=q;else w(n.children||[],q)})})(D.menu,[]);return r||[id]}\nconst crumb=ids=>{const m=nodeMap();return ids.map(x=>m[x]?lab(m[x]):x).join(' › ')};\nfunction codeCard(i,full){\n  const t=T(),N=D.meta.code_preview_lines||4,ls=i.content.split('\\n');if(ls[ls.length-1]==='')ls.pop();\n  let ex=!!full;const c=E('article','cc l-'+i.lang);\n  c.innerHTML=`<div class=\"cch\"><span class=\"lg\">${esc(i.lang_label||i.lang)}</span><div class=\"ct\"><b>${esc(ttl(i))}</b><small>${esc(pick(i.desc,i.desc_bn))}</small><span class=\"id\">${esc(i.id)} · ${esc(i.filename)} · ${ls.length} ${t.ln}</span><small class=\"cr\">📁 ${esc(crumb(i.menu_path||[]))}</small></div><div class=\"ca\"><button data-a=\"c\">${t.cp}</button><button data-a=\"d\" title=\"${t.dl}\">↓</button></div></div><div class=\"cb\"><pre class=\"gt\"></pre><pre class=\"cd\"><code></code></pre></div><button class=\"tg2\"></button>`;\n  const tg=c.querySelector('.tg2'),cb=c.querySelector('.cb');\n  const draw=()=>{const sh=ex?ls:ls.slice(0,N);c.querySelector('.gt').textContent=sh.map((_,k)=>k+1).join('\\n');c.querySelector('code').textContent=sh.join('\\n');c.classList.toggle('fade',!ex&&ls.length>N);tg.hidden=ls.length<=N;tg.textContent=ex?t.co:`${t.sa} (${ls.length} ${t.ln})`};\n  tg.onclick=()=>{ex=!ex;draw()};cb.onclick=()=>{if(!ex&&ls.length>N){ex=true;draw()}};\n  c.querySelector('[data-a=c]').onclick=e=>{const b=e.target,done=()=>{b.textContent=t.cpd;setTimeout(()=>b.textContent=t.cp,1500)};\n    (navigator.clipboard?navigator.clipboard.writeText(i.content):Promise.reject()).then(done).catch(()=>{const a=E('textarea');a.value=i.content;document.body.append(a);a.select();document.execCommand('copy');a.remove();done()})};\n  c.querySelector('[data-a=d]').onclick=()=>{const a=E('a');a.href=URL.createObjectURL(new Blob([i.content],{type:'text/plain'}));a.download=i.filename;a.click()};\n  draw();return c}\n\nfunction row(i){\n  const t=T(),s=i.status||i.result,r=E('div','row');\n  r.innerHTML=`<span class=\"id\">${esc(i.id)}</span><span class=\"tt\">${esc(ttl(i))}</span><span>${s?`<span class=\"b ${s}\">${t.st[s]||s}</span>`:''}${i.priority?`<span class=\"b ${i.priority}\">${t.st[i.priority]}</span>`:''}${overdue(i)?`<span class=\"b fail\">${t.overdue}</span>`:''}${i.pinned?'<span class=\"b\">📌</span>':''}${i.lang_label?`<span class=\"lg l-${esc(i.lang)}\">${esc(i.lang_label)}</span>`:''}</span>`;\n  r.onclick=()=>showM(i.id);return r}\n\nfunction showM(id){\n  const it=items('all').find(x=>x.id===id);if(!it)return;mId=id;\n  const t=T(),skip=['history','title','title_bn','_k','id','content','sha256','lang','ext','desc_bn','menu_path'],p=$('#mp');\n  const val=(k,v)=>k==='desc'?esc(pick(v,it.desc_bn)):Array.isArray(v)?(k==='related'?v.map(x=>`<span class=\"lnk\" data-id=\"${esc(x)}\">${esc(x)}</span>`).join(''):esc(v.join(', '))):k.endsWith('_at')||k==='due'?fmt(v):k==='status'||k==='priority'||k==='result'?esc(t.st[v]||v):esc(v===true?'✔':v);\n  p.innerHTML=`<button class=\"x\" aria-label=\"Close\">×</button><div class=\"id\">${esc(it.id)} <a class=\"lnk\" href=\"#${esc(it.id)}\" style=\"font-size:12px\" onclick=\"navigator.clipboard&&navigator.clipboard.writeText('${esc(it.id)}')\">${t.copy}</a></div><h2>${esc(ttl(it))}</h2><dl>${Object.entries(it).filter(([k,v])=>!skip.includes(k)&&v!==''&&!(Array.isArray(v)&&!v.length)).map(([k,v])=>`<dt>${esc(t.fk[k]||k)}</dt><dd>${val(k,v)}</dd>`).join('')}</dl><h2 style=\"font-size:16px\">${t.history}</h2><div class=\"hist\">${(it.history||[]).map(h=>`<div>${fmt(h.at)} — ${esc(h.event)}${h.note?': '+esc(h.note):''}</div>`).join('')}</div>`;\n  p.style.width=it._k==='codes'?'min(900px,100%)':'';if(it._k==='codes')p.querySelector('h2').after(codeCard(it,true));p.querySelector('.x').onclick=closeM;p.querySelectorAll('[data-id]').forEach(e=>e.onclick=()=>showM(e.dataset.id));\n  $('#modal').classList.add('on');location.hash=id}\nfunction closeM(){$('#modal').classList.remove('on');history.replaceState(null,'',location.pathname)}\naddEventListener('hashchange',()=>{if(D&&location.hash.length>1)showM(location.hash.slice(1))});\n</script>\n</body>\n</html>\n```\n\n---\n\n`add_code.py`\n```\n#!/usr/bin/env python3\n\"\"\"Save a whole file (local path or http/https URL) into CodeCraft.\n\npython3 add_code.py ~/mj/portal/index.html \"Title\" \"Description\" --bn \"শিরোনাম\" --bn \"বর্ণনা\"\n  (1st --bn = title BN, 2nd --bn = description BN; or --title-bn / --desc-bn)\n\nWhere it goes (see the tree with:  ./run.sh menu):\n  (nothing)                        -> CodeCraft > <file type>        e.g. CodeCraft > HTML\n  --menu \"CodeCraft/Web/Portal\"    -> into an existing menu/submenu (menu id or name path)\n  --new-menu \"UI/Forms\"            -> create nested submenus (under --menu, or CodeCraft) and put it there\n  --new-menu-bn \"ইউআই/ফর্ম\"        -> Bangla names for the new submenus, same order\nOther: --category X --tags a,b --lang python --force.  No arguments = interactive.\"\"\"\nimport argparse, os, urllib.request\nfrom urllib.parse import urlparse\nfrom _lib import *\nMAX = 2 * 1024 * 1024\na = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)\na.add_argument(\"source\", nargs=\"?\", default=\"\"); a.add_argument(\"title\", nargs=\"?\", default=\"\"); a.add_argument(\"desc\", nargs=\"?\", default=\"\")\na.add_argument(\"--bn\", action=\"append\", default=[]); a.add_argument(\"--title-bn\", default=\"\"); a.add_argument(\"--desc-bn\", default=\"\")\na.add_argument(\"--menu\", default=\"\"); a.add_argument(\"--new-menu\", default=\"\"); a.add_argument(\"--new-menu-bn\", default=\"\")\na.add_argument(\"--category\", default=\"general\"); a.add_argument(\"--tags\", default=\"\"); a.add_argument(\"--lang\", default=\"\"); a.add_argument(\"--force\", action=\"store_true\")\nx = a.parse_intermixed_args()\nif not x.source:\n    print(\"— New CodeCraft entry (Enter to skip optional fields) —\")\n    x.source = ask(\"File path or URL *\", req=True); x.title = ask(\"Title (EN)\"); x.title_bn = ask(\"শিরোনাম (BN)\")\n    x.desc = ask(\"Description (EN)\"); x.desc_bn = ask(\"বর্ণনা (BN)\")\n    x.menu = ask(\"Existing menu (id or path, Enter = by file type; ./run.sh menu shows the tree)\")\n    x.new_menu = ask(\"New submenu name(s) e.g. UI/Forms (optional)\"); x.new_menu_bn = ask(\"নতুন সাবমেনুর বাংলা নাম (optional)\") if x.new_menu else \"\"\n    x.category = ask(\"Category\", \"general\"); x.tags = ask(\"Tags a,b\")\ntb = x.title_bn or (x.bn[0] if x.bn else \"\"); db = x.desc_bn or (x.bn[1] if len(x.bn) > 1 else \"\")\nsrc = x.source\ntry:\n    if src.startswith((\"http://\", \"https://\")):\n        with urllib.request.urlopen(urllib.request.Request(src, headers={\"User-Agent\": \"mj-registry\"}), timeout=20) as r: raw = r.read(MAX + 1)\n        name = os.path.basename(urlparse(src).path) or \"index.html\"\n    else:\n        p = os.path.abspath(os.path.expanduser(src))\n        if not os.path.isfile(p): die(f\"file not found: {src}\")\n        with open(p, \"rb\") as f: raw = f.read(MAX + 1)\n        name = os.path.basename(p)\nexcept Exception as e: die(f\"could not read {src}: {e}\")\nif len(raw) > MAX: die(\"file larger than 2 MB\")\ntry: text = raw.decode(\"utf-8-sig\").replace(\"\\r\\n\", \"\\n\")\nexcept UnicodeDecodeError: die(\"not a UTF-8 text file (binary files are not supported)\")\nlang, label = detect(name, text, x.lang.lower())\nsha = hashlib.sha256(text.encode(\"utf-8\")).hexdigest()\nd = normalize(load()); root = ensure_root(d)\ndup = next((c for c in d[\"codes\"] if c.get(\"sha256\") == sha), None)\nif dup and not x.force: die(f\"identical content already saved as {dup['id']} (use --force to add anyway)\")\nnode, path = root, [\"codecraft\"]\nif x.menu:\n    node, path = find_node(d, x.menu)\n    if not node: die(f\"menu not found: {x.menu}  (run ./run.sh menu to see the tree, or create it with --new-menu)\")\nif x.new_menu:\n    node, path = ensure_chain(d, node, path, [s.strip() for s in x.new_menu.split(\"/\") if s.strip()], x.new_menu_bn.split(\"/\"))\nelif not x.menu:\n    node, path = ensure_chain(d, root, [\"codecraft\"], [label])\ni = next_id(d, \"code\")\nd[\"codes\"].append({\"id\": i, \"title\": x.title or name, \"title_bn\": tb, \"desc\": x.desc, \"desc_bn\": db, \"filename\": name,\n  \"source\": src, \"lang\": lang, \"lang_label\": label, \"ext\": name.rsplit(\".\", 1)[-1].lower() if \".\" in name else \"\",\n  \"lines\": text.count(\"\\n\") + (0 if text == \"\" or text.endswith(\"\\n\") else 1), \"bytes\": len(raw), \"sha256\": sha,\n  \"menu_path\": path, \"category\": x.category, \"tags\": tags(x.tags), \"created_at\": now(),\n  \"history\": [{\"at\": now(), \"event\": \"created\", \"note\": src}], \"content\": text})\nsave(d); print(f\"✔ CodeCraft added: {i}  [{label}]  {name}  →  \" + \" › \".join(next(n for n, p in walk(d['menu']) if n['id'] == k)['en'] for k in path))\n```\n\n---\n\n`_lib.py`\n```\n#!/usr/bin/env python3\n\"\"\"Shared helpers: load/save data.json safely, unique IDs, history log.\"\"\"\nimport json, os, shutil, sys\nfrom datetime import datetime\nHERE = os.path.dirname(os.path.abspath(__file__))\nDATA = os.path.join(HERE, \"data.json\")\nKIND = {\"task\": (\"TSK\", \"tasks\"), \"note\": (\"NOT\", \"notes\"), \"audit\": (\"AUD\", \"audits\"), \"code\": (\"CDE\", \"codes\")}\n\ndef now(): return datetime.now().astimezone().isoformat(timespec=\"seconds\")\n\ndef load():\n    with open(DATA, encoding=\"utf-8\") as f: d = json.load(f)\n    d.setdefault(\"codes\", []); return d\n\ndef save(d):\n    d[\"meta\"][\"updated_at\"] = now()\n    if os.path.exists(DATA): shutil.copy(DATA, DATA + \".bak\")\n    tmp = DATA + \".tmp\"\n    with open(tmp, \"w\", encoding=\"utf-8\") as f:\n        json.dump(d, f, ensure_ascii=False, indent=2)\n    os.replace(tmp, DATA)\n\ndef next_id(d, kind):\n    \"\"\"Never reuses an ID: PREFIX-YYYY-NNNN, counter kept per kind & year.\"\"\"\n    p, _ = KIND[kind]; y = datetime.now().year\n    c = d[\"meta\"].setdefault(\"counters\", {}).setdefault(kind, {})\n    c[str(y)] = c.get(str(y), 0) + 1\n    return f\"{p}-{y}-{c[str(y)]:04d}\"\n\ndef find(d, id_):\n    for k, (p, key) in KIND.items():\n        for it in d[key]:\n            if it[\"id\"] == id_: return k, it\n    return None, None\n\ndef tags(s): return [t.strip() for t in (s or \"\").split(\",\") if t.strip()]\n\ndef die(msg): print(\"ERROR:\", msg, file=sys.stderr); sys.exit(1)\n\ndef ask(label, default=\"\", req=False, choices=None):\n    \"\"\"Interactive prompt used when a script runs without arguments.\"\"\"\n    while True:\n        v = input(f\"{label}{' ['+default+']' if default else ''}: \").strip() or default\n        if req and not v: print(\"  required\"); continue\n        if choices and v not in choices: print(\"  choose:\", \"/\".join(choices)); continue\n        return v\n\nimport hashlib\nEXT = {\"html\":(\"html\",\"HTML\"),\"htm\":(\"html\",\"HTML\"),\"json\":(\"json\",\"JSON\"),\"py\":(\"python\",\"Python\"),\n \"js\":(\"node\",\"Node.js\"),\"mjs\":(\"node\",\"Node.js\"),\"cjs\":(\"node\",\"Node.js\"),\"ts\":(\"ts\",\"TypeScript\"),\n \"jsx\":(\"react\",\"React\"),\"tsx\":(\"react\",\"React\"),\"sh\":(\"shell\",\"Shell\"),\"bash\":(\"shell\",\"Shell\"),\n \"css\":(\"css\",\"CSS\"),\"md\":(\"markdown\",\"Markdown\"),\"yml\":(\"yaml\",\"YAML\"),\"yaml\":(\"yaml\",\"YAML\"),\n \"sql\":(\"sql\",\"SQL\"),\"xml\":(\"xml\",\"XML\"),\"php\":(\"php\",\"PHP\"),\"java\":(\"java\",\"Java\"),\"c\":(\"c\",\"C\"),\n \"cpp\":(\"cpp\",\"C++\"),\"go\":(\"go\",\"Go\"),\"rs\":(\"rust\",\"Rust\"),\"txt\":(\"text\",\"Text\")}\nSHEBANG = {\"python\":(\"python\",\"Python\"),\"node\":(\"node\",\"Node.js\"),\"bash\":(\"shell\",\"Shell\"),\"sh\":(\"shell\",\"Shell\")}\n\ndef detect(name, text, force=\"\"):\n    if force:\n        return next((v for v in EXT.values() if v[0] == force), (force, force.upper()))\n    ext = name.rsplit(\".\", 1)[-1].lower() if \".\" in name else \"\"\n    if ext in EXT: return EXT[ext]\n    if text.startswith(\"#!\"):\n        for k, v in SHEBANG.items():\n            if k in text.split(\"\\n\", 1)[0]: return v\n    return (\"text\", \"Text\")\n\nimport re\ndef walk(ns, path=()):\n    for n in ns:\n        yield n, path + (n[\"id\"],)\n        yield from walk(n.get(\"children\", []), path + (n[\"id\"],))\n\ndef find_node(d, ref):\n    \"\"\"ref = menu id, or a label path like 'CodeCraft/Web/Portal' (EN/BN/id, case-insensitive). -> (node, [id path]) or (None, None)\"\"\"\n    ref = ref.strip()\n    for n, p in walk(d[\"menu\"]):\n        if n[\"id\"] == ref: return n, list(p)\n    segs = [s.strip().lower() for s in ref.strip(\"/\").split(\"/\") if s.strip()]\n    if not segs: return None, None\n    def go(ns, sg, path):\n        for n in ns:\n            if sg[0] in (n[\"id\"].lower(), (n.get(\"en\") or \"\").lower(), (n.get(\"bn\") or \"\").lower()):\n                if len(sg) == 1: return n, path + [n[\"id\"]]\n                r = go(n.get(\"children\", []), sg[1:], path + [n[\"id\"]])\n                if r[0]: return r\n        return None, None\n    r = go(d[\"menu\"], segs, [])\n    if r[0]: return r\n    root = next((n for n in d[\"menu\"] if n[\"id\"] == \"codecraft\"), None)   # 'Web/Portal' means CodeCraft/Web/Portal\n    return go(root.get(\"children\", []), segs, [\"codecraft\"]) if root else (None, None)\n\ndef ensure_root(d):\n    root = next((n for n in d[\"menu\"] if n[\"id\"] == \"codecraft\"), None)\n    if not root:\n        root = {\"id\": \"codecraft\", \"bn\": \"কোডক্রাফ্ট\", \"en\": \"CodeCraft\", \"icon\": \"❮❯\", \"open\": True, \"view\": {\"type\": \"codes\"}, \"children\": []}\n        k = next((j for j, n in enumerate(d[\"menu\"]) if n[\"id\"] == \"registry\"), len(d[\"menu\"])); d[\"menu\"].insert(k, root)\n    root.setdefault(\"children\", []); return root\n\ndef ensure_chain(d, parent, ppath, names, bns=()):\n    \"\"\"Create (or reuse, matched by name) nested submenus under parent. -> (deepest node, id path)\"\"\"\n    ids = {n[\"id\"] for n, _ in walk(d[\"menu\"])}\n    for k, name in enumerate(names):\n        sib = parent.setdefault(\"children\", [])\n        hit = next((c for c in sib if name.lower() in ((c.get(\"en\") or \"\").lower(), (c.get(\"bn\") or \"\").lower())), None)\n        if not hit:\n            bn = bns[k].strip() if k < len(bns) and bns[k].strip() else name\n            base = \"c-\" + (re.sub(r\"[^a-z0-9]+\", \"-\", name.lower()).strip(\"-\") or \"m\"); nid = base; i = 2\n            while nid in ids: nid = f\"{base}-{i}\"; i += 1\n            ids.add(nid)\n            hit = {\"id\": nid, \"bn\": bn, \"en\": name, \"view\": {\"type\": \"codes\", \"filter\": {\"menu_path\": nid}}}\n            sib.append(hit)\n        parent = hit; ppath = ppath + [hit[\"id\"]]\n    return parent, ppath\n\ndef normalize(d):\n    \"\"\"Upgrade older data: language nodes filter by menu_path; entries get a menu_path.\"\"\"\n    root = ensure_root(d)\n    for c in root[\"children\"]:\n        f = c.get(\"view\", {}).get(\"filter\", {})\n        if \"lang\" in f: c[\"view\"][\"filter\"] = {\"menu_path\": c[\"id\"]}\n    for it in d[\"codes\"]:\n        it.setdefault(\"menu_path\", [\"codecraft\", \"c-\" + it[\"lang\"]])\n    return d\n```\n\n---\n\n`validate.py`\n```\n#!/usr/bin/env python3\n\"\"\"Checks data.json integrity. Exit 0 = OK, 1 = problems.\"\"\"\nimport re\nfrom _lib import *\nd = load(); errs = []; seen = set()\nreq = {\"task\": [\"id\", \"title\", \"status\", \"priority\", \"created_at\"], \"note\": [\"id\", \"title\", \"created_at\"],\n       \"audit\": [\"id\", \"title\", \"result\", \"created_at\"],\n       \"code\": [\"id\", \"title\", \"lang\", \"content\", \"created_at\"]}\nfor k, (p, key) in KIND.items():\n    for it in d.get(key, []):\n        i = it.get(\"id\", \"?\")\n        if i in seen: errs.append(f\"duplicate ID {i}\")\n        seen.add(i)\n        if not re.fullmatch(rf\"{p}-\\d{{4}}-\\d{{4,}}\", i): errs.append(f\"bad ID format {i}\")\n        errs += [f\"{i}: missing '{f}'\" for f in req[k] if not it.get(f)]\n        if k == \"code\" and it.get(\"content\") and hashlib.sha256(it[\"content\"].encode(\"utf-8\")).hexdigest() != it.get(\"sha256\"): errs.append(f\"{i}: content hash mismatch\")\n        c = d[\"meta\"].get(\"counters\", {}).get(k, {}).get(i.split(\"-\")[1], 0)\n        if i[:3] == p and int(i.split(\"-\")[2]) > c: errs.append(f\"{i}: counter behind ({c})\")\nfor key in (\"tasks\", \"notes\", \"audits\", \"codes\"):\n    for it in d.get(key, []):\n        for r in it.get(\"related\", []):\n            if r not in seen: errs.append(f\"{it['id']}: related ID missing {r}\")\nmids = []\ndef walk(ns):\n    for n in ns:\n        mids.append(n.get(\"id\")); \n        if not n.get(\"id\") or not (n.get(\"bn\") or n.get(\"en\")): errs.append(f\"menu node needs id+label: {n}\")\n        walk(n.get(\"children\", []))\nwalk(d.get(\"menu\", []))\nfor it in d.get('codes', []):\n    errs += [f\"{it['id']}: menu_path id not in menu: {m}\" for m in it.get('menu_path', []) if m not in mids]\nerrs += [f\"duplicate menu id {m}\" for m in set(mids) if mids.count(m) > 1]\nif errs: print(\"✘ Problems:\"); [print(\"  -\", e) for e in errs]; sys.exit(1)\nprint(f\"✔ OK — {len(d['tasks'])} tasks, {len(d['notes'])} notes, {len(d['audits'])} audits, {len(d['codes'])} codes, {len(mids)} menu nodes\")\n```\n\n---\n\n`run.sh`\n```\n#!/usr/bin/env bash\n# ./run.sh task|note|audit|code|menu|done|check|serve [args...]\ncd \"$(dirname \"$0\")\"\nc=\"$1\"; shift\ncase \"$c\" in\n  task) python3 add_task.py \"$@\" && python3 validate.py ;;\n  note) python3 add_note.py \"$@\" && python3 validate.py ;;\n  audit) python3 add_audit.py \"$@\" && python3 validate.py ;;\n  done) python3 complete_task.py \"$@\" && python3 validate.py ;;\n  code) python3 add_code.py \"$@\" && python3 validate.py ;;\n  menu) python3 menu.py \"$@\" && python3 validate.py ;;\n  check) python3 validate.py ;;\n  serve) echo \"Open http://localhost:8000\"; python3 -m http.server 8000 ;;\n  *) echo \"usage: ./run.sh task|note|audit|code|menu|done|check|serve ...\" ;;\nesac\n```\n\n---\n\n`data.json`\n```\n{\n  \"meta\": {\n    \"title\": \"MJ Ahmad\",\n    \"subtitle_bn\": \"টাস্ক · নোট · অডিট রেজিস্ট্রি\",\n    \"subtitle_en\": \"Task · Note · Audit Registry\",\n    \"logo\": \"assets/logo.png\",\n    \"splash_ms\": 1800,\n    \"version\": \"1.3\",\n    \"footer_bn\": \"সকল তথ্য data.json থেকে লোড হয়\",\n    \"footer_en\": \"All data is loaded from data.json\",\n    \"updated_at\": \"\",\n    \"counters\": {\n      \"task\": {\n        \"2026\": 3\n      },\n      \"note\": {\n        \"2026\": 2\n      },\n      \"audit\": {\n        \"2026\": 2\n      },\n      \"code\": {}\n    },\n    \"tagline\": \"Where every script is a verdict, every invocation a vote, and every log a legacy.\",\n    \"links\": [\n      {\n        \"icon\": \"◈\",\n        \"en\": \"Current project\",\n        \"bn\": \"চলমান প্রজেক্ট\",\n        \"url\": \"https://MJ-Ahmad.github.io/qf\"\n      },\n      {\n        \"icon\": \"◎\",\n        \"en\": \"Website\",\n        \"bn\": \"ওয়েবসাইট\",\n        \"url\": \"https://MJ-Ahmad.github.io/mj\"\n      },\n      {\n        \"icon\": \"✉\",\n        \"en\": \"mjahmad2024@outlook.com\",\n        \"bn\": \"mjahmad2024@outlook.com\",\n        \"url\": \"mailto:mjahmad2024@outlook.com\"\n      },\n      {\n        \"icon\": \"in\",\n        \"en\": \"LinkedIn\",\n        \"bn\": \"লিংকডিন\",\n        \"url\": \"https://www.linkedin.com/in/jafor-ahmad\"\n      }\n    ],\n    \"commands\": [\n      {\n        \"en\": \"Start viewer\",\n        \"bn\": \"ভিউয়ার চালু\",\n        \"cmd\": \"./run.sh serve\"\n      },\n      {\n        \"en\": \"Add task\",\n        \"bn\": \"টাস্ক যুক্ত\",\n        \"cmd\": \"./run.sh task \\\"Title\\\" --bn \\\"শিরোনাম\\\" --priority high --due 2026-12-31\"\n      },\n      {\n        \"en\": \"Add note\",\n        \"bn\": \"নোট যুক্ত\",\n        \"cmd\": \"./run.sh note \\\"Title\\\" --body \\\"...\\\" --pinned\"\n      },\n      {\n        \"en\": \"Add audit\",\n        \"bn\": \"অডিট যুক্ত\",\n        \"cmd\": \"./run.sh audit \\\"Title\\\" --result pass --related TSK-2026-0001\"\n      },\n      {\n        \"en\": \"Add code file / URL\",\n        \"bn\": \"কোড ফাইল / লিংক যুক্ত\",\n        \"cmd\": \"./run.sh code ~/mj/portal/index.html \\\"Title\\\" \\\"Description\\\" --bn \\\"শিরোনাম\\\" --bn \\\"বর্ণনা\\\"\"\n      },\n      {\n        \"en\": \"Show / manage menu tree\",\n        \"bn\": \"মেনু ট্রি দেখা / পরিচালনা\",\n        \"cmd\": \"./run.sh menu   |   ./run.sh menu --new \\\"Web/Portal\\\"   |   ./run.sh menu --move CDE-2026-0001 --to \\\"CodeCraft/Web\\\"\"\n      },\n      {\n        \"en\": \"Complete task\",\n        \"bn\": \"টাস্ক সম্পন্ন\",\n        \"cmd\": \"./run.sh done TSK-2026-0001 --note \\\"done\\\"\"\n      },\n      {\n        \"en\": \"Validate data\",\n        \"bn\": \"ডাটা যাচাই\",\n        \"cmd\": \"./run.sh check\"\n      },\n      {\n        \"en\": \"Emergency: restore last backup\",\n        \"bn\": \"জরুরি: শেষ ব্যাকআপ ফেরত\",\n        \"cmd\": \"cp data.json.bak data.json && ./run.sh check\"\n      },\n      {\n        \"en\": \"Port busy? use another\",\n        \"bn\": \"পোর্ট ব্যস্ত হলে অন্যটি\",\n        \"cmd\": \"python3 -m http.server 8080\"\n      }\n    ],\n    \"code_preview_lines\": 4\n  },\n  \"menu\": [\n    {\n      \"id\": \"dash\",\n      \"bn\": \"ড্যাশবোর্ড\",\n      \"en\": \"Dashboard\",\n      \"icon\": \"◧\",\n      \"view\": {\n        \"type\": \"dashboard\"\n      }\n    },\n    {\n      \"id\": \"tasks\",\n      \"bn\": \"টাস্ক\",\n      \"en\": \"Tasks\",\n      \"icon\": \"☑\",\n      \"open\": true,\n      \"view\": {\n        \"type\": \"tasks\"\n      },\n      \"children\": [\n        {\n          \"id\": \"t-todo\",\n          \"bn\": \"করণীয়\",\n          \"en\": \"To do\",\n          \"view\": {\n            \"type\": \"tasks\",\n            \"filter\": {\n              \"status\": \"todo\"\n            }\n          }\n        },\n        {\n          \"id\": \"t-doing\",\n          \"bn\": \"চলমান\",\n          \"en\": \"In progress\",\n          \"view\": {\n            \"type\": \"tasks\",\n            \"filter\": {\n              \"status\": \"doing\"\n            }\n          }\n        },\n        {\n          \"id\": \"t-done\",\n          \"bn\": \"সম্পন্ন\",\n          \"en\": \"Done\",\n          \"view\": {\n            \"type\": \"tasks\",\n            \"filter\": {\n              \"status\": \"done\"\n            }\n          }\n        },\n        {\n          \"id\": \"t-pri\",\n          \"bn\": \"অগ্রাধিকার\",\n          \"en\": \"By priority\",\n          \"children\": [\n            {\n              \"id\": \"t-urgent\",\n              \"bn\": \"জরুরি\",\n              \"en\": \"Urgent\",\n              \"view\": {\n                \"type\": \"tasks\",\n                \"filter\": {\n                  \"priority\": \"urgent\"\n                }\n              }\n            },\n            {\n              \"id\": \"t-high\",\n              \"bn\": \"উচ্চ\",\n              \"en\": \"High\",\n              \"view\": {\n                \"type\": \"tasks\",\n                \"filter\": {\n                  \"priority\": \"high\"\n                }\n              }\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"notes\",\n      \"bn\": \"নোট\",\n      \"en\": \"Notes\",\n      \"icon\": \"✎\",\n      \"view\": {\n        \"type\": \"notes\"\n      },\n      \"children\": [\n        {\n          \"id\": \"n-pin\",\n          \"bn\": \"পিন করা\",\n          \"en\": \"Pinned\",\n          \"view\": {\n            \"type\": \"notes\",\n            \"filter\": {\n              \"pinned\": true\n            }\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"audits\",\n      \"bn\": \"অডিট\",\n      \"en\": \"Audits\",\n      \"icon\": \"⚖\",\n      \"view\": {\n        \"type\": \"audits\"\n      },\n      \"children\": [\n        {\n          \"id\": \"a-pass\",\n          \"bn\": \"উত্তীর্ণ\",\n          \"en\": \"Pass\",\n          \"view\": {\n            \"type\": \"audits\",\n            \"filter\": {\n              \"result\": \"pass\"\n            }\n          }\n        },\n        {\n          \"id\": \"a-warn\",\n          \"bn\": \"সতর্কতা\",\n          \"en\": \"Warning\",\n          \"view\": {\n            \"type\": \"audits\",\n            \"filter\": {\n              \"result\": \"warning\"\n            }\n          }\n        },\n        {\n          \"id\": \"a-fail\",\n          \"bn\": \"ব্যর্থ\",\n          \"en\": \"Fail\",\n          \"view\": {\n            \"type\": \"audits\",\n            \"filter\": {\n              \"result\": \"fail\"\n            }\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"codecraft\",\n      \"bn\": \"কোডক্রাফ্ট\",\n      \"en\": \"CodeCraft\",\n      \"icon\": \"❮❯\",\n      \"open\": true,\n      \"view\": {\n        \"type\": \"codes\"\n      },\n      \"children\": []\n    },\n    {\n      \"id\": \"registry\",\n      \"bn\": \"রেজিস্ট্রি (সব)\",\n      \"en\": \"Registry (all)\",\n      \"icon\": \"☰\",\n      \"view\": {\n        \"type\": \"all\"\n      }\n    }\n  ],\n  \"tasks\": [\n    {\n      \"id\": \"TSK-2026-0001\",\n      \"title\": \"Set up project registry\",\n      \"title_bn\": \"প্রজেক্ট রেজিস্ট্রি সেটআপ\",\n      \"desc\": \"Create index.html, data.json and scripts.\",\n      \"status\": \"done\",\n      \"priority\": \"high\",\n      \"due\": \"\",\n      \"category\": \"setup\",\n      \"tags\": [\n        \"setup\"\n      ],\n      \"created_at\": \"2026-09-24T09:00:00+06:00\",\n      \"completed_at\": \"2026-09-24T10:00:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:00:00+06:00\",\n          \"event\": \"created\"\n        },\n        {\n          \"at\": \"2026-09-24T10:00:00+06:00\",\n          \"event\": \"status → done\",\n          \"note\": \"\"\n        }\n      ]\n    },\n    {\n      \"id\": \"TSK-2026-0002\",\n      \"title\": \"Add logo to assets/\",\n      \"title_bn\": \"assets/ এ লোগো যুক্ত করুন\",\n      \"desc\": \"Place logo.png inside assets folder.\",\n      \"status\": \"todo\",\n      \"priority\": \"urgent\",\n      \"due\": \"2026-09-30\",\n      \"category\": \"setup\",\n      \"tags\": [\n        \"logo\"\n      ],\n      \"created_at\": \"2026-09-24T09:05:00+06:00\",\n      \"completed_at\": \"\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:05:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    },\n    {\n      \"id\": \"TSK-2026-0003\",\n      \"title\": \"Review weekly entries\",\n      \"title_bn\": \"সাপ্তাহিক এন্ট্রি পর্যালোচনা\",\n      \"desc\": \"\",\n      \"status\": \"doing\",\n      \"priority\": \"medium\",\n      \"due\": \"2026-10-01\",\n      \"category\": \"review\",\n      \"tags\": [\n        \"weekly\"\n      ],\n      \"created_at\": \"2026-09-24T09:10:00+06:00\",\n      \"completed_at\": \"\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:10:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    }\n  ],\n  \"notes\": [\n    {\n      \"id\": \"NOT-2026-0001\",\n      \"title\": \"How this system works\",\n      \"title_bn\": \"এই সিস্টেম যেভাবে কাজ করে\",\n      \"body\": \"index.html never changes. Add data with the scripts; the page reads data.json.\",\n      \"category\": \"guide\",\n      \"tags\": [\n        \"guide\"\n      ],\n      \"pinned\": true,\n      \"created_at\": \"2026-09-24T09:15:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:15:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    },\n    {\n      \"id\": \"NOT-2026-0002\",\n      \"title\": \"ID format\",\n      \"title_bn\": \"আইডি ফরম্যাট\",\n      \"body\": \"TSK / NOT / AUD + year + serial. IDs are never reused.\",\n      \"category\": \"guide\",\n      \"tags\": [\n        \"id\"\n      ],\n      \"pinned\": false,\n      \"created_at\": \"2026-09-24T09:20:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:20:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    }\n  ],\n  \"audits\": [\n    {\n      \"id\": \"AUD-2026-0001\",\n      \"title\": \"Data integrity check\",\n      \"title_bn\": \"ডাটা ইন্টিগ্রিটি যাচাই\",\n      \"result\": \"pass\",\n      \"target\": \"data.json\",\n      \"findings\": \"No duplicate IDs.\",\n      \"auditor\": \"MJ Ahmad\",\n      \"related\": [\n        \"TSK-2026-0001\"\n      ],\n      \"category\": \"system\",\n      \"tags\": [\n        \"integrity\"\n      ],\n      \"created_at\": \"2026-09-24T10:10:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T10:10:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    },\n    {\n      \"id\": \"AUD-2026-0002\",\n      \"title\": \"Logo file present\",\n      \"title_bn\": \"লোগো ফাইল আছে কিনা\",\n      \"result\": \"warning\",\n      \"target\": \"assets/logo.png\",\n      \"findings\": \"Logo not yet added.\",\n      \"auditor\": \"MJ Ahmad\",\n      \"related\": [\n        \"TSK-2026-0002\"\n      ],\n      \"category\": \"system\",\n      \"tags\": [\n        \"logo\"\n      ],\n      \"created_at\": \"2026-09-24T10:12:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T10:12:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    }\n  ],\n  \"codes\": []\n}\n```\n\n---\n\nCodeCraft যুক্ত করেছি। স্ক্রিপ্টগুলো একটি কপিতে আপনার উদাহরণের মতো করে চালিয়ে পরীক্ষা করেছি, আইডি, মেনু ও validate ঠিক কাজ করেছে। CodeCraft-এর কার্ড আর মেনু ব্রাউজারে খুলে দেখিনি, শুধু JavaScript-এর সিনট্যাক্স যাচাই করেছি।\n\n**ব্যবহার**\n```\n./run.sh code ~/mj/portal/index.html \"Title\" \"Description\" --bn \"শিরোনাম\" --bn \"বর্ণনা\"\n./add_code.py https://example.com/app.py \"API script\"     # লিংক থেকেও চলে\n./add_code.py                                              # আর্গুমেন্ট ছাড়া = প্রশ্নোত্তর মোড\n```\nপ্রথম `--bn` শিরোনামের বাংলা, দ্বিতীয় `--bn` বর্ণনার বাংলা। চাইলে `--title-bn` ও `--desc-bn` আলাদা করেও দেওয়া যায়। শিরোনাম না দিলে ফাইলের নামই শিরোনাম হয়।\n\n**কী ঘটে**\n- পুরো ফাইলের কনটেন্ট `data.json`-এর `codes`-এ যায় এবং আইডি হয় `CDE-2026-0001` ধরনের।\n- ফাইলের ধরন এক্সটেনশন বা shebang দেখে চেনা হয় (HTML, JSON, Python, Node.js, Shell, CSS, TypeScript, SQL ইত্যাদি)। ভুল ধরা পড়লে `--lang python` দিয়ে ঠিক করা যায়।\n- CodeCraft মেনুর নিচে ওই ধরনের সাব-মেনু নিজে থেকে তৈরি হয়, যেমন CodeCraft → HTML।\n- একই কনটেন্ট দ্বিতীয়বার দিলে আটকে দেয়, `--force` দিলে যুক্ত হয়। ২ MB-র বড় বা বাইনারি ফাইল নেয় না।\n\n**দেখতে যেমন**\n- কার্ডের এক পাশে ধরনের রঙিন ব্যাজ, অন্য পাশে **Copy** (পুরো কোড কপি হয়) ও ডাউনলোড বোতাম।\n- কোড ডার্ক প্যানেলে লাইন নম্বরসহ শুরুতে ৪ লাইন দেখায়। ওই সংখ্যা `data.json`-এর `meta.code_preview_lines` থেকে বদলানো যায়।\n- **Show all** বা কোডের অংশে ক্লিক করলে পুরোটা খোলে, **Collapse** চাপলে আগের অবস্থায় ফেরে।\n- ড্যাশবোর্ড, সার্চ ও রেজিস্ট্রিতেও CodeCraft আসে। EN|BN টগল এখানেও কাজ করে।\n\n`index.html`-এ CodeCraft দেখানোর জন্য শেষবারের মতো একটি বদল করা হয়েছে। এরপর নতুন ধরনের ফাইল যোগ করলেও এটি বদলাতে হবে না। আপডেট হয়েছে `index.html`, `add_code.py` (নতুন), `_lib.py`, `validate.py`, `run.sh` ও `data.json`। আপনার `data.json`-এ নিজের এন্ট্রি থাকলে রিপ্লেস না করে তিনটি জিনিস হাতে যোগ করুন: `\"codes\": []`, মেনুতে `codecraft` নোড, আর `meta.counters`-এ `\"code\": {}`।\n\n---\n\n\n",
      "menu_path": [
        "codecraft",
        "c-markdown"
      ]
    },
