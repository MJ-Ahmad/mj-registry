     \"created_at\": \"2026-09-24T20:52:15+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T20:52:15+06:00\",\n          \"event\": \"created\",\n          \"note\": \"/data/data/com.termux/files/home/mj/index.html\"\n        }\n      ],\n      \"content\": \"<!DOCTYPE html>\\n<html lang=\\\"en\\\">\\n<head>\\n  <meta charset=\\\"UTF-8\\\" />\\n  <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n  <title>MJSovereign | Loading...</title>\\n  <link rel=\\\"stylesheet\\\" href=\\\"css/style.css\\\" />\\n  <style>\\n    /* Splash overlay styles */\\n    body {\\n      margin: 0;\\n      font-family: Arial, sans-serif;\\n    }\\n    #splash {\\n      position: fixed;\\n      top: 0; left: 0;\\n      width: 100%; height: 100%;\\n      background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);\\n      display: flex;\\n      justify-content: center;\\n      align-items: center;\\n      flex-direction: column;\\n      z-index: 9999;\\n      color: #fff;\\n    }\\n    #splash img {\\n      width: 180px;\\n      animation: fadeIn 2s ease-in-out;\\n    }\\n    .progress-bar {\\n      width: 300px;\\n      height: 10px;\\n      background: rgba(255,255,255,0.2);\\n      border-radius: 5px;\\n      margin: 20px auto;\\n      overflow: hidden;\\n    }\\n    .progress {\\n      height: 100%;\\n      width: 0;\\n      background: #00ffcc;\\n      transition: width 0.3s ease;\\n    }\\n    .loading-text {\\n      margin-top: 15px;\\n      font-size: 1.1em;\\n      animation: pulse 1.5s infinite;\\n    }\\n    @keyframes fadeIn {\\n      from { opacity: 0; transform: scale(0.8); }\\n      to { opacity: 1; transform: scale(1); }\\n    }\\n    @keyframes pulse {\\n      0% { opacity: 0.5; }\\n      50% { opacity: 1; }\\n      100% { opacity: 0.5; }\\n    }\\n  </style>\\n</head>\\n<body>\\n  <!-- Splash overlay -->\\n  <div id=\\\"splash\\\">\\n    <img src=\\\"logo.png\\\" alt=\\\"MJSovereign Logo\\\">\\n    <div class=\\\"progress-bar\\\"><div class=\\\"progress\\\"></div></div>\\n    <p class=\\\"loading-text\\\">Preparing your sovereign experience...</p>\\n  </div>\\n\\n  <!-- Splash script -->\\n  <script>\\n    let progress = document.querySelector(\\\".progress\\\");\\n    let width = 0;\\n    let interval = setInterval(() => {\\n      if (width >= 100) {\\n        clearInterval(interval);\\n        // Redirect to home.html after splash\\n        window.location.href = \\\"home.html\\\";\\n      } else {\\n        width++;\\n        progress.style.width = width + \\\"%\\\";\\n      }\\n    }, 30); // 3 seconds total\\n  </script>\\n</body>\\n</html>\\n\",\n      \"menu_path\": [\n        \"codecraft\",\n        \"c-html\"\n      ]\n    },\n    {\n      \"id\": \"CDE-2026-0002\",\n      \"title\": \"MJ Registry chat\",\n      \"title_bn\": \"mj-registry চ্যাট\",\n      \"desc\": \"Chat with Claude.ai about mj-registry\",\n      \"desc_bn\": \"Chat with claude about mj-registry\",\n      \"filename\": \"mj-registry_claude_chat_v1.md\",\n      \"source\": \"/data/data/com.termux/files/home/backup/mj-registry_claude_chat_v1.md\",\n      \"lang\": \"markdown\",\n      \"lang_label\": \"Markdown\",\n      \"ext\": \"md\",\n      \"lines\": 2924,\n      \"bytes\": 153391,\n      \"sha256\": \"81f37614ad9250ca8c50780527677444e9e7aaddb2de4fe089250f0206ccb49a\",\n      \"category\": \"general\",\n      \"tags\": [],\n      \"created_at\": \"2026-09-25T01:15:21+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-25T01:15:21+06:00\",\n          \"event\": \"created\",\n          \"note\": \"/data/data/com.termux/files/home/backup/mj-registry_claude_chat_v1.md\"\n        }\n      ],\n      \"content\": \"# MJ-Registry\\n\\nV1.0 \\n\\n`index.html`\\n```\\n<!DOCTYPE html>\\n<html lang=\\\"bn\\\">\\n<head>\\n<meta charset=\\\"utf-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n<title>MJ Ahmad — Registry</title>\\n<link href=\\\"https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&display=swap\\\" rel=\\\"stylesheet\\\">\\n<style>\\n:root{--bg:#F3F5F2;--pan:#FFFFFF;--ink:#16211E;--mut:#5F6E69;--line:#D9DFDB;--pine:#0F4C42;--brass:#B8862B;--ok:#2E7D4F;--warn:#B8862B;--bad:#B3412E;--sel:#E3EEEA;--r:6px}\\n@media(prefers-color-scheme:dark){:root{--bg:#0F1514;--pan:#161E1C;--ink:#E6ECE9;--mut:#93A29C;--line:#26332F;--pine:#5FB59F;--brass:#D4A74A;--ok:#5DB985;--warn:#D4A74A;--bad:#E1705B;--sel:#1E2D29}}\\n*{box-sizing:border-box;margin:0}\\nhtml,body{height:100%}\\nbody{font-family:\\\"Hind Siliguri\\\",\\\"Noto Sans Bengali\\\",system-ui,sans-serif;background:var(--bg);color:var(--ink);display:flex;flex-direction:column;font-size:15px;line-height:1.5}\\n:focus-visible{outline:2px solid var(--brass);outline-offset:2px}\\n#splash{position:fixed;inset:0;z-index:99;background:var(--pine);color:#F3F5F2;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:14px;cursor:pointer;transition:opacity .5s}\\n#splash.out{opacity:0;pointer-events:none}\\n#splash img{width:96px;height:96px;object-fit:contain}\\n#splash h1{font-size:34px;font-weight:700;letter-spacing:.5px}\\n#splash p{opacity:.8}\\n#splash i{display:block;height:2px;width:0;background:var(--brass);animation:bar var(--ms,1.8s) linear forwards}\\n@keyframes bar{to{width:180px}}\\nheader{display:flex;align-items:center;gap:12px;padding:10px 16px;background:var(--pine);color:#F3F5F2;flex:none}\\nheader img{width:36px;height:36px;object-fit:contain}\\nheader h1{font-size:18px;font-weight:700;line-height:1.2}\\nheader small{display:block;opacity:.8;font-size:12px}\\n#q{margin-left:auto;width:min(320px,45%);padding:7px 10px;border-radius:var(--r);border:1px solid #ffffff44;background:#ffffff1c;color:#fff;font:inherit}\\n#q::placeholder{color:#ffffffaa}\\n#burger{display:none;background:none;border:0;color:#fff;font-size:22px}\\n.main{flex:1;display:flex;min-height:0}\\nnav{width:290px;flex:none;overflow:auto;background:var(--pan);border-right:1px solid var(--line);padding:10px 6px}\\nnav ul{list-style:none;padding:0}\\nnav ul ul{margin-left:14px;border-left:1px solid var(--line);padding-left:4px}\\n.node{display:flex;align-items:center;gap:6px;padding:6px 8px;border-radius:var(--r);cursor:pointer;user-select:none}\\n.node:hover{background:var(--sel)}\\n.node.act{background:var(--sel);color:var(--pine);font-weight:600;box-shadow:inset 3px 0 var(--brass)}\\n.chev{width:16px;text-align:center;color:var(--mut);transition:transform .15s;flex:none}\\n.open>.node .chev{transform:rotate(90deg)}\\nnav li>ul{display:none}nav li.open>ul{display:block}\\n.ic{width:18px;text-align:center;flex:none}\\n.lb{flex:1;min-width:0}.lb small{display:block;color:var(--mut);font-size:11.5px;line-height:1.2;font-weight:400}\\n.cnt{font-size:11.5px;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:0 7px;color:var(--mut)}\\nsection#view{flex:1;overflow:auto;padding:20px 24px}\\nh2{font-size:22px;margin-bottom:2px}.sub{color:var(--mut);margin-bottom:14px}\\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px;margin-bottom:22px}\\n.stat{background:var(--pan);border:1px solid var(--line);border-radius:var(--r);padding:12px;cursor:pointer}\\n.stat b{font-size:28px;display:block;line-height:1.1}.stat span{color:var(--mut);font-size:13px}\\n.stat.bad b{color:var(--bad)}\\n.bar{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:12px}\\n.chip{border:1px solid var(--line);background:var(--pan);color:var(--ink);border-radius:16px;padding:2px 12px;font:inherit;font-size:13px;cursor:pointer}\\n.chip.on{background:var(--pine);color:#fff;border-color:var(--pine)}\\n.row{display:grid;grid-template-columns:132px 1fr auto;gap:12px;align-items:center;background:var(--pan);border:1px solid var(--line);border-radius:var(--r);padding:9px 12px;margin-bottom:6px;cursor:pointer}\\n.row:hover{border-color:var(--pine)}\\n.id{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;color:var(--pine)}\\n.tt small{display:block;color:var(--mut);font-size:12.5px}\\n.b{display:inline-block;font-size:12px;border-radius:4px;padding:0 7px;border:1px solid var(--line);margin-left:4px;white-space:nowrap}\\n.b.todo,.b.low,.b.pass{color:var(--ok)}.b.doing,.b.medium,.b.warning{color:var(--warn)}.b.high,.b.urgent,.b.fail{color:var(--bad)}.b.done{color:var(--mut)}\\n.empty{padding:40px 0;color:var(--mut);text-align:center}\\n#modal{position:fixed;inset:0;background:#0008;display:none;z-index:50;justify-content:flex-end}\\n#modal.on{display:flex}\\n#modal .p{width:min(520px,100%);background:var(--pan);height:100%;overflow:auto;padding:22px}\\n#modal dl{display:grid;grid-template-columns:110px 1fr;gap:6px 10px;margin:14px 0}\\n#modal dt{color:var(--mut)}#modal dd{margin:0;word-break:break-word}\\n#modal .lnk{color:var(--pine);cursor:pointer;text-decoration:underline;font-family:ui-monospace,monospace;font-size:13px;margin-right:8px}\\n.hist{border-left:2px solid var(--line);padding-left:12px;margin-top:8px;font-size:13px;color:var(--mut)}\\n.hist div{margin-bottom:6px}\\n.x{float:right;background:none;border:0;font-size:22px;color:var(--mut);cursor:pointer}\\nfooter{flex:none;padding:8px 16px;background:var(--pan);border-top:1px solid var(--line);color:var(--mut);font-size:12.5px;display:flex;flex-wrap:wrap;gap:6px 18px;justify-content:space-between}\\n@media(max-width:820px){#burger{display:block}nav{position:fixed;top:56px;bottom:0;left:0;z-index:40;transform:translateX(-100%);transition:transform .2s;width:290px}nav.on{transform:none}.row{grid-template-columns:1fr}section#view{padding:14px}}\\n.lang{display:flex;border:1px solid #ffffff55;border-radius:var(--r);overflow:hidden;flex:none}\\n.lang button{background:none;border:0;color:#fff;padding:5px 11px;font:inherit;font-size:13px;font-weight:600;cursor:pointer;opacity:.75}\\n.lang button+button{border-left:1px solid #ffffff55}\\n.lang button.on{background:var(--brass);opacity:1}\\n#splash .tg{font-style:italic;max-width:420px;text-align:center;font-size:13px;opacity:.65;padding:0 20px}\\nfooter{gap:8px;flex-direction:column;align-items:stretch;max-height:45vh;overflow:auto}\\nfooter a{color:var(--pine);text-decoration:none;font-weight:500}footer a:hover{text-decoration:underline}\\n.fl{display:flex;flex-wrap:wrap;gap:6px 20px}\\nfooter summary{cursor:pointer;color:var(--ink);font-weight:500}\\n.cm{display:grid;grid-template-columns:200px 1fr;gap:4px 12px;padding:4px 0;border-bottom:1px dashed var(--line)}\\n.cm code{font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12.5px;color:var(--pine);cursor:pointer;word-break:break-all}\\n.fq{font-style:italic;color:var(--ink)}\\n@media(max-width:820px){.cm{grid-template-columns:1fr}#q{width:34%}}\\n.lg{background:var(--lc,#6B7B76);color:#fff;font-size:12px;font-weight:700;border-radius:4px;padding:1px 8px;letter-spacing:.4px;white-space:nowrap;align-self:flex-start}\\n.row .lg{margin-left:4px}\\n.l-html{--lc:#D8552B}.l-json{--lc:#A38F1A}.l-python{--lc:#3776AB}.l-node{--lc:#3F8A36}.l-shell{--lc:#3E8E3E}.l-css{--lc:#2965F1}.l-ts{--lc:#3178C6}.l-react{--lc:#1F8EA8}.l-markdown{--lc:#5B6B8C}.l-sql{--lc:#8A5AA8}\\n.cc{background:var(--pan);border:1px solid var(--line);border-left:4px solid var(--lc,#6B7B76);border-radius:var(--r);margin-bottom:14px;overflow:hidden}\\n.cch{display:flex;gap:12px;align-items:flex-start;padding:10px 12px}\\n.ct{flex:1;min-width:0}.ct small{display:block;color:var(--mut)}\\n.ca{display:flex;gap:6px}\\n.ca button,.tg2{border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:var(--r);padding:3px 12px;font:inherit;font-size:13px;cursor:pointer}\\n.ca button:hover,.tg2:hover{border-color:var(--pine);color:var(--pine)}\\n.tg2{margin:8px 12px 10px}\\n.cb{display:flex;background:#0F1917;color:#D8E4DF;font:12.5px/1.6 ui-monospace,Menlo,Consolas,monospace;overflow:auto;position:relative;max-height:70vh}\\n.cb pre{margin:0}.cb .gt{padding:10px 10px 10px 12px;color:#5F7A72;text-align:right;user-select:none;border-right:1px solid #ffffff14;position:sticky;left:0;background:#0F1917}\\n.cb .cd{padding:10px 14px;flex:1;min-width:0;tab-size:2}\\n.cc.fade .cb{cursor:pointer;overflow:hidden}.cc.fade .cb::after{content:\\\"\\\";position:absolute;left:0;right:0;bottom:0;height:30px;background:linear-gradient(transparent,#0F1917)}\\n@media(prefers-reduced-motion:reduce){*{transition:none!important;animation-duration:.01s!important}}\\n</style>\\n</head>\\n<body>\\n<div id=\\\"splash\\\"><img id=\\\"sl\\\" alt=\\\"Logo\\\"><h1 id=\\\"st\\\">MJ Ahmad</h1><p id=\\\"ss\\\"></p><p id=\\\"sq\\\" class=\\\"tg\\\"></p><i></i></div>\\n<header>\\n  <button id=\\\"burger\\\" aria-label=\\\"Menu\\\">☰</button>\\n  <img id=\\\"hl\\\" alt=\\\"Logo\\\">\\n  <div><h1 id=\\\"ht\\\">MJ Ahmad</h1><small id=\\\"hs\\\"></small></div>\\n  <input id=\\\"q\\\" type=\\\"search\\\" placeholder=\\\"খুঁজুন / Search — ID, শিরোনাম, ট্যাগ…\\\" aria-label=\\\"Search\\\">\\n  <div class=\\\"lang\\\" id=\\\"lang\\\" role=\\\"group\\\" aria-label=\\\"Language\\\"><button data-l=\\\"en\\\">EN</button><button data-l=\\\"bn\\\">BN</button></div>\\n</header>\\n<div class=\\\"main\\\"><nav id=\\\"nav\\\" aria-label=\\\"Menu\\\"></nav><section id=\\\"view\\\"></section></div>\\n<footer><div class=\\\"fl\\\" id=\\\"fl\\\"></div><details id=\\\"fd\\\"><summary id=\\\"fs\\\"></summary><div id=\\\"fc\\\"></div></details><div class=\\\"fq\\\" id=\\\"fq\\\"></div><div class=\\\"fm\\\" id=\\\"f2\\\"></div></footer>\\n<div id=\\\"modal\\\"><div class=\\\"p\\\" id=\\\"mp\\\"></div></div>\\n<script>\\nconst $=s=>document.querySelector(s),E=(t,c,h)=>{const e=document.createElement(t);if(c)e.className=c;if(h!=null)e.innerHTML=h;return e};\\nconst esc=s=>String(s??'').replace(/[&<>\\\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\\\"':'&quot;'}[c]));\\nconst UI={\\nen:{search:'Search — ID, title, tag…',dash:'Dashboard',recent:'Recent',searchT:'Search',all:'All',empty:'Nothing here yet. Add entries with ./run.sh',overdue:'Overdue',history:'History',copy:'copy',openT:'Open tasks',done:'Done',notes:'Notes',audits:'Audits',failed:'Failed audits',t:'tasks',n:'notes',a:'audits',upd:'Updated',cmds:'Quick commands & emergency help',err:'Could not load data.json. Run ./run.sh serve and open http://localhost:8000',menu:'Menu',codes:'CodeCraft',cp:'Copy',cpd:'Copied ✓',dl:'Download',sa:'Show all',co:'Collapse',ln:'lines',\\n st:{todo:'To do',doing:'In progress',done:'Done',low:'Low',medium:'Medium',high:'High',urgent:'Urgent',pass:'Pass',warning:'Warning',fail:'Fail'},\\n ty:{tasks:'Tasks',notes:'Notes',audits:'Audits',all:'Registry',codes:'CodeCraft'},\\n fk:{status:'Status',priority:'Priority',due:'Due',category:'Category',tags:'Tags',created_at:'Created',completed_at:'Completed',desc:'Description',body:'Note',result:'Result',target:'Target',findings:'Findings',auditor:'Auditor',related:'Related',pinned:'Pinned',filename:'File',source:'Source',lang_label:'Type',lines:'Lines',bytes:'Size (bytes)'}},\\nbn:{search:'খুঁজুন — আইডি, শিরোনাম, ট্যাগ…',dash:'ড্যাশবোর্ড',recent:'সাম্প্রতিক',searchT:'অনুসন্ধান',all:'সব',empty:'এখনো কিছু নেই। ./run.sh দিয়ে যুক্ত করুন',overdue:'মেয়াদোত্তীর্ণ',history:'ইতিহাস',copy:'কপি',openT:'খোলা টাস্ক',done:'সম্পন্ন',notes:'নোট',audits:'অডিট',failed:'ব্যর্থ অডিট',t:'টাস্ক',n:'নোট',a:'অডিট',upd:'আপডেট',cmds:'দ্রুত কমান্ড ও জরুরি নির্দেশনা',err:'data.json লোড হয়নি। ./run.sh serve চালিয়ে http://localhost:8000 খুলুন',menu:'মেনু',codes:'কোডক্রাফ্ট',cp:'কপি',cpd:'কপি হয়েছে ✓',dl:'ডাউনলোড',sa:'সবটুকু দেখুন',co:'গুটিয়ে নিন',ln:'লাইন',\\n st:{todo:'করণীয়',doing:'চলমান',done:'সম্পন্ন',low:'নিম্ন',medium:'মাঝারি',high:'উচ্চ',urgent:'জরুরি',pass:'উত্তীর্ণ',warning:'সতর্কতা',fail:'ব্যর্থ'},\\n ty:{tasks:'টাস্ক',notes:'নোট',audits:'অডিট',all:'রেজিস্ট্রি',codes:'কোডক্রাফ্ট'},\\n fk:{status:'অবস্থা',priority:'অগ্রাধিকার',due:'শেষ তারিখ',category:'বিভাগ',tags:'ট্যাগ',created_at:'তৈরি',completed_at:'সম্পন্ন হয়েছে',desc:'বিবরণ',body:'নোট',result:'ফলাফল',target:'লক্ষ্য',findings:'পর্যবেক্ষণ',auditor:'অডিটর',related:'সম্পর্কিত',pinned:'পিন করা',filename:'ফাইল',source:'উৎস',lang_label:'ধরন',lines:'লাইন',bytes:'আকার (বাইট)'}}};\\nlet D,lang='en',cur={type:'dashboard'},curId='dash',open=new Set(),sf='',search='',mId='';\\ntry{const s=localStorage.getItem('mj_lang');if(s==='bn'||s==='en')lang=s}catch(e){}\\nconst T=()=>UI[lang],pick=(en,bn)=>lang==='bn'?(bn||en):(en||bn),lab=n=>pick(n.en,n.bn),ttl=i=>pick(i.title,i.title_bn);\\nconst items=t=>t==='all'?[...D.tasks.map(x=>({...x,_k:'tasks'})),...D.notes.map(x=>({...x,_k:'notes'})),...D.audits.map(x=>({...x,_k:'audits'})),...(D.codes||[]).map(x=>({...x,_k:'codes',menu_path:x.menu_path||['codecraft','c-'+x.lang]}))]:(D[t]||[]).map(x=>({...x,_k:t}));\\nconst match=(it,f)=>!f||Object.entries(f).every(([k,v])=>Array.isArray(it[k])?it[k].includes(v):it[k]===v);\\nconst cnt=v=>v&&v.type!=='dashboard'?items(v.type).filter(i=>match(i,v.filter)).length:null;\\nconst fmt=s=>s?new Date(s).toLocaleString(lang==='bn'?'bn-BD':'en-GB',{dateStyle:'medium',timeStyle:'short'}):'—';\\nconst overdue=t=>t.status!=='done'&&t.due&&t.due<new Date().toISOString().slice(0,10);\\n\\nfetch('data.json?'+Date.now()).then(r=>r.json()).then(init).catch(e=>{$('#view').innerHTML='<div class=\\\"empty\\\">'+esc(T().err)+'<br><small>'+esc(e)+'</small></div>';hideSplash()});\\n\\nfunction init(d){\\n  D=d;const m=d.meta;\\n  $('#hl').src=$('#sl').src=m.logo;\\n  (function pre(ns){ns.forEach(n=>{if(n.open)open.add(n.id);pre(n.children||[])})})(D.menu);\\n  $('#splash').style.setProperty('--ms',(m.splash_ms||1800)+'ms');\\n  document.querySelectorAll('#lang button').forEach(b=>b.onclick=()=>{lang=b.dataset.l;try{localStorage.setItem('mj_lang',lang)}catch(e){}applyLang()});\\n  applyLang();\\n  if(location.hash.length>1)showM(location.hash.slice(1));\\n  setTimeout(hideSplash,m.splash_ms||1800);\\n}\\nfunction applyLang(){\\n  const m=D.meta,t=T(),sub=pick(m.subtitle_en,m.subtitle_bn);\\n  document.documentElement.lang=lang;document.title=m.title+' — '+sub;\\n  $('#ht').textContent=$('#st').textContent=m.title;$('#hs').textContent=$('#ss').textContent=sub;\\n  $('#sq').textContent=m.tagline||'';$('#q').placeholder=t.search;\\n  document.querySelectorAll('#lang button').forEach(b=>b.classList.toggle('on',b.dataset.l===lang));\\n  drawNav();drawFooter();render();if($('#modal').classList.contains('on'))showM(mId)}\\nfunction hideSplash(){$('#splash').classList.add('out')}\\n$('#splash').onclick=hideSplash;\\n$('#burger').onclick=()=>$('#nav').classList.toggle('on');\\n$('#q').oninput=e=>{search=e.target.value.trim().toLowerCase();render()};\\n$('#modal').onclick=e=>{if(e.target.id==='modal')closeM()};\\naddEventListener('keydown',e=>{if(e.key==='Escape')closeM()});\\n\\nfunction drawFooter(){\\n  const m=D.meta,t=T();\\n  $('#fl').innerHTML=(m.links||[]).map(l=>`<a href=\\\"${esc(l.url)}\\\"${l.url.startsWith('mailto:')?'':' target=\\\"_blank\\\" rel=\\\"noopener\\\"'}><span>${esc(l.icon||'')}</span> ${esc(pick(l.en,l.bn))}</a>`).join('');\\n  const c=m.commands||[];$('#fd').hidden=!c.length;$('#fs').textContent=t.cmds;\\n  $('#fc').innerHTML=c.map(x=>`<div class=\\\"cm\\\"><span>${esc(pick(x.en,x.bn))}</span><code title=\\\"click to copy\\\">${esc(x.cmd)}</code></div>`).join('');\\n  $('#fc').querySelectorAll('code').forEach(e=>e.onclick=()=>navigator.clipboard&&navigator.clipboard.writeText(e.textContent));\\n  $('#fq').textContent=m.tagline?'“'+m.tagline+'”':'';\\n  $('#f2').textContent=`${pick(m.footer_en,m.footer_bn)} · v${m.version} · ${D.tasks.length} ${t.t} · ${D.notes.length} ${t.n} · ${D.audits.length} ${t.a} · ${(D.codes||[]).length} ${t.codes} · ${t.upd} ${fmt(m.updated_at)} · © ${new Date().getFullYear()} ${m.title}`}\\n\\nfunction drawNav(){const nav=$('#nav');nav.innerHTML='';nav.append(tree(D.menu))}\\nfunction tree(ns){\\n  const ul=E('ul');\\n  ns.forEach(n=>{\\n    const li=E('li',open.has(n.id)?'open':''),kids=n.children&&n.children.length,c=cnt(n.view);\\n    const row=E('div','node'+(n.id===curId?' act':''));\\n    row.innerHTML=`<span class=\\\"chev\\\">${kids?'›':''}</span><span class=\\\"ic\\\">${n.icon||''}</span><span class=\\\"lb\\\">${esc(lab(n))}</span>${c!=null?`<span class=\\\"cnt\\\">${c}</span>`:''}`;\\n    row.tabIndex=0;\\n    const go=()=>{if(kids){open.has(n.id)?open.delete(n.id):open.add(n.id)}if(n.view){cur=n.view;curId=n.id;sf='';$('#nav').classList.remove('on')}drawNav();render()};\\n    row.onclick=go;row.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();go()}};\\n    li.append(row);if(kids)li.append(tree(n.children));ul.append(li)});\\n  return ul}\\n\\nfunction render(){\\n  const v=$('#view');v.innerHTML='';\\n  if(search){list(v,'all',null,true);return}\\n  cur.type==='dashboard'?dash(v):list(v,cur.type,cur.filter)}\\n\\nfunction dash(v){\\n  const t=T(),TK=D.tasks,A=D.audits;\\n  v.innerHTML=`<h2>${t.dash}</h2>`;\\n  const g=E('div','grid');\\n  [[t.openT,TK.filter(x=>x.status!=='done').length,'tasks',{}],[t.done,TK.filter(x=>x.status==='done').length,'tasks',{status:'done'}],[t.overdue,TK.filter(overdue).length,'tasks',{},'bad'],[t.notes,D.notes.length,'notes',{}],[t.audits,A.length,'audits',{}],[t.failed,A.filter(a=>a.result==='fail').length,'audits',{result:'fail'},'bad'],[t.codes,(D.codes||[]).length,'codes',{}]]\\n   .forEach(([l,n,ty,f,c])=>{const s=E('div','stat '+(c||''),`<b>${n}</b><span>${l}</span>`);s.onclick=()=>{cur={type:ty,filter:f};curId='';drawNav();render()};g.append(s)});\\n  v.append(g,E('h2','',t.recent));\\n  items('all').sort((a,b)=>b.created_at.localeCompare(a.created_at)).slice(0,8).forEach(i=>v.append(row(i)))}\\n\\nfunction list(v,type,filter,isSearch){\\n  const t=T();\\n  const nm=isSearch?null:nodeMap()[curId];\\n  v.append(E('h2','',isSearch?t.searchT:(nm&&nm.view&&nm.view.type===type?lab(nm):t.ty[type])));\\n  if(nm&&nm.view&&nm.view.filter&&nm.view.filter.menu_path)v.append(E('div','sub','📁 '+esc(crumb(pathOf(nm.view.filter.menu_path)))));\\n  if(nm&&nm.children&&nm.children.length){const b=E('div','bar');nm.children.forEach(c=>{const n=cnt(c.view),ch=E('button','chip',esc(lab(c))+(n!=null?` (${n})`:''));ch.onclick=()=>{open.add(nm.id);if(c.view){cur=c.view;curId=c.id;sf=''}drawNav();render()};b.append(ch)});v.append(b)}\\n  if(isSearch)v.append(E('div','sub','“'+esc(search)+'”'));\\n  let arr=items(type).filter(i=>match(i,filter)).filter(i=>!search||[i.id,i.title,i.title_bn,i.desc,i.body,i.findings,i.desc_bn,i.filename,i.content,i.category,(i.tags||[]).join(' ')].join(' ').toLowerCase().includes(search));\\n  const sts=[...new Set(arr.map(i=>i.status||i.result).filter(Boolean))];\\n  if(sts.length>1){const b=E('div','bar');['',...sts].forEach(s=>{const c=E('button','chip'+(sf===s?' on':''),s?t.st[s]||s:t.all);c.onclick=()=>{sf=s;render()};b.append(c)});v.append(b)}\\n  arr=arr.filter(i=>!sf||(i.status||i.result)===sf).sort((a,b)=>b.id.localeCompare(a.id));\\n  if(!arr.length)v.append(E('div','empty',t.empty));\\n  arr.forEach(i=>v.append(type==='codes'&&!isSearch?codeCard(i):row(i)))}\\n\\nconst nodeMap=()=>{const m={};(function w(ns){ns.forEach(n=>{m[n.id]=n;w(n.children||[])})})(D.menu);return m};\\nfunction pathOf(id){let r=null;(function w(ns,p){ns.forEach(n=>{const q=[...p,n.id];if(n.id===id)r=q;else w(n.children||[],q)})})(D.menu,[]);return r||[id]}\\nconst crumb=ids=>{const m=nodeMap();return ids.map(x=>m[x]?lab(m[x]):x).join(' › ')};\\nfunction codeCard(i,full){\\n  const t=T(),N=D.meta.code_preview_lines||4,ls=i.content.split('\\\\n');if(ls[ls.length-1]==='')ls.pop();\\n  let ex=!!full;const c=E('article','cc l-'+i.lang);\\n  c.innerHTML=`<div class=\\\"cch\\\"><span class=\\\"lg\\\">${esc(i.lang_label||i.lang)}</span><div class=\\\"ct\\\"><b>${esc(ttl(i))}</b><small>${esc(pick(i.desc,i.desc_bn))}</small><span class=\\\"id\\\">${esc(i.id)} · ${esc(i.filename)} · ${ls.length} ${t.ln}</span><small class=\\\"cr\\\">📁 ${esc(crumb(i.menu_path||[]))}</small></div><div class=\\\"ca\\\"><button data-a=\\\"c\\\">${t.cp}</button><button data-a=\\\"d\\\" title=\\\"${t.dl}\\\">↓</button></div></div><div class=\\\"cb\\\"><pre class=\\\"gt\\\"></pre><pre class=\\\"cd\\\"><code></code></pre></div><button class=\\\"tg2\\\"></button>`;\\n  const tg=c.querySelector('.tg2'),cb=c.querySelector('.cb');\\n  const draw=()=>{const sh=ex?ls:ls.slice(0,N);c.querySelector('.gt').textContent=sh.map((_,k)=>k+1).join('\\\\n');c.querySelector('code').textContent=sh.join('\\\\n');c.classList.toggle('fade',!ex&&ls.length>N);tg.hidden=ls.length<=N;tg.textContent=ex?t.co:`${t.sa} (${ls.length} ${t.ln})`};\\n  tg.onclick=()=>{ex=!ex;draw()};cb.onclick=()=>{if(!ex&&ls.length>N){ex=true;draw()}};\\n  c.querySelector('[data-a=c]').onclick=e=>{const b=e.target,done=()=>{b.textContent=t.cpd;setTimeout(()=>b.textContent=t.cp,1500)};\\n    (navigator.clipboard?navigator.clipboard.writeText(i.content):Promise.reject()).then(done).catch(()=>{const a=E('textarea');a.value=i.content;document.body.append(a);a.select();document.execCommand('copy');a.remove();done()})};\\n  c.querySelector('[data-a=d]').onclick=()=>{const a=E('a');a.href=URL.createObjectURL(new Blob([i.content],{type:'text/plain'}));a.download=i.filename;a.click()};\\n  draw();return c}\\n\\nfunction row(i){\\n  const t=T(),s=i.status||i.result,r=E('div','row');\\n  r.innerHTML=`<span class=\\\"id\\\">${esc(i.id)}</span><span class=\\\"tt\\\">${esc(ttl(i))}</span><span>${s?`<span class=\\\"b ${s}\\\">${t.st[s]||s}</span>`:''}${i.priority?`<span class=\\\"b ${i.priority}\\\">${t.st[i.priority]}</span>`:''}${overdue(i)?`<span class=\\\"b fail\\\">${t.overdue}</span>`:''}${i.pinned?'<span class=\\\"b\\\">📌</span>':''}${i.lang_label?`<span class=\\\"lg l-${esc(i.lang)}\\\">${esc(i.lang_label)}</span>`:''}</span>`;\\n  r.onclick=()=>showM(i.id);return r}\\n\\nfunction showM(id){\\n  const it=items('all').find(x=>x.id===id);if(!it)return;mId=id;\\n  const t=T(),skip=['history','title','title_bn','_k','id','content','sha256','lang','ext','desc_bn','menu_path'],p=$('#mp');\\n  const val=(k,v)=>k==='desc'?esc(pick(v,it.desc_bn)):Array.isArray(v)?(k==='related'?v.map(x=>`<span class=\\\"lnk\\\" data-id=\\\"${esc(x)}\\\">${esc(x)}</span>`).join(''):esc(v.join(', '))):k.endsWith('_at')||k==='due'?fmt(v):k==='status'||k==='priority'||k==='result'?esc(t.st[v]||v):esc(v===true?'✔':v);\\n  p.innerHTML=`<button class=\\\"x\\\" aria-label=\\\"Close\\\">×</button><div class=\\\"id\\\">${esc(it.id)} <a class=\\\"lnk\\\" href=\\\"#${esc(it.id)}\\\" style=\\\"font-size:12px\\\" onclick=\\\"navigator.clipboard&&navigator.clipboard.writeText('${esc(it.id)}')\\\">${t.copy}</a></div><h2>${esc(ttl(it))}</h2><dl>${Object.entries(it).filter(([k,v])=>!skip.includes(k)&&v!==''&&!(Array.isArray(v)&&!v.length)).map(([k,v])=>`<dt>${esc(t.fk[k]||k)}</dt><dd>${val(k,v)}</dd>`).join('')}</dl><h2 style=\\\"font-size:16px\\\">${t.history}</h2><div class=\\\"hist\\\">${(it.history||[]).map(h=>`<div>${fmt(h.at)} — ${esc(h.event)}${h.note?': '+esc(h.note):''}</div>`).join('')}</div>`;\\n  p.style.width=it._k==='codes'?'min(900px,100%)':'';if(it._k==='codes')p.querySelector('h2').after(codeCard(it,true));p.querySelector('.x').onclick=closeM;p.querySelectorAll('[data-id]').forEach(e=>e.onclick=()=>showM(e.dataset.id));\\n  $('#modal').classList.add('on');location.hash=id}\\nfunction closeM(){$('#modal').classList.remove('on');history.replaceState(null,'',location.pathname)}\\naddEventListener('hashchange',()=>{if(D&&location.hash.length>1)showM(location.hash.slice(1))});\\n</script>\\n</body>\\n</html>\\n```\\n\\n----\\n\\n`data.json`\\n```\\n{\\n  \\\"meta\\\": {\\n    \\\"title\\\": \\\"MJ Ahmad\\\",\\n    \\\"subtitle_bn\\\": \\\"টাস্ক · নোট · অডিট রেজিস্ট্রি\\\",\\n    \\\"subtitle_en\\\": \\\"Task · Note · Audit Registry\\\",\\n    \\\"logo\\\": \\\"assets/logo.png\\\",\\n    \\\"splash_ms\\\": 1800,\\n    \\\"version\\\": \\\"1.3\\\",\\n    \\\"footer_bn\\\": \\\"সকল তথ্য data.json থেকে লোড হয়\\\",\\n    \\\"footer_en\\\": \\\"All data is loaded from data.json\\\",\\n    \\\"updated_at\\\": \\\"\\\",\\n    \\\"counters\\\": {\\n      \\\"task\\\": {\\n        \\\"2026\\\": 3\\n      },\\n      \\\"note\\\": {\\n        \\\"2026\\\": 2\\n      },\\n      \\\"audit\\\": {\\n        \\\"2026\\\": 2\\n      },\\n      \\\"code\\\": {}\\n    },\\n    \\\"tagline\\\": \\\"Where every script is a verdict, every invocation a vote, and every log a legacy.\\\",\\n    \\\"links\\\": [\\n      {\\n        \\\"icon\\\": \\\"◈\\\",\\n        \\\"en\\\": \\\"Current project\\\",\\n        \\\"bn\\\": \\\"চলমান প্রজেক্ট\\\",\\n        \\\"url\\\": \\\"https://MJ-Ahmad.github.io/qf\\\"\\n      },\\n      {\\n        \\\"icon\\\": \\\"◎\\\",\\n        \\\"en\\\": \\\"Website\\\",\\n        \\\"bn\\\": \\\"ওয়েবসাইট\\\",\\n        \\\"url\\\": \\\"https://MJ-Ahmad.github.io/mj\\\"\\n      },\\n      {\\n        \\\"icon\\\": \\\"✉\\\",\\n        \\\"en\\\": \\\"mjahmad2024@outlook.com\\\",\\n        \\\"bn\\\": \\\"mjahmad2024@outlook.com\\\",\\n        \\\"url\\\": \\\"mailto:mjahmad2024@outlook.com\\\"\\n      },\\n      {\\n        \\\"icon\\\": \\\"in\\\",\\n        \\\"en\\\": \\\"LinkedIn\\\",\\n        \\\"bn\\\": \\\"লিংকডিন\\\",\\n        \\\"url\\\": \\\"https://www.linkedin.com/in/jafor-ahmad\\\"\\n      }\\n    ],\\n    \\\"commands\\\": [\\n      {\\n        \\\"en\\\": \\\"Start viewer\\\",\\n        \\\"bn\\\": \\\"ভিউয়ার চালু\\\",\\n        \\\"cmd\\\": \\\"./run.sh serve\\\"\\n      },\\n      {\\n        \\\"en\\\": \\\"Add task\\\",\\n        \\\"bn\\\": \\\"টাস্ক যুক্ত\\\",\\n        \\\"cmd\\\": \\\"./run.sh task \\\\\\\"Title\\\\\\\" --bn \\\\\\\"শিরোনাম\\\\\\\" --priority high --due 2026-12-31\\\"\\n      },\\n      {\\n        \\\"en\\\": \\\"Add note\\\",\\n        \\\"bn\\\": \\\"নোট যুক্ত\\\",\\n        \\\"cmd\\\": \\\"./run.sh note \\\\\\\"Title\\\\\\\" --body \\\\\\\"...\\\\\\\" --pinned\\\"\\n      },\\n      {\\n        \\\"en\\\": \\\"Add audit\\\",\\n        \\\"bn\\\": \\\"অডিট যুক্ত\\\",\\n        \\\"cmd\\\": \\\"./run.sh audit \\\\\\\"Title\\\\\\\" --result pass --related TSK-2026-0001\\\"\\n      },\\n      {\\n        \\\"en\\\": \\\"Add code file / URL\\\",\\n        \\\"bn\\\": \\\"কোড ফাইল / লিংক যুক্ত\\\",\\n        \\\"cmd\\\": \\\"./run.sh code ~/mj/portal/index.html \\\\\\\"Title\\\\\\\" \\\\\\\"Description\\\\\\\" --bn \\\\\\\"শিরোনাম\\\\\\\" --bn \\\\\\\"বর্ণনা\\\\\\\"\\\"\\n      },\\n      {\\n        \\\"en\\\": \\\"Show / manage menu tree\\\",\\n        \\\"bn\\\": \\\"মেনু ট্রি দেখা / পরিচালনা\\\",\\n        \\\"cmd\\\": \\\"./run.sh menu   |   ./run.sh menu --new \\\\\\\"Web/Portal\\\\\\\"   |   ./run.sh menu --move CDE-2026-0001 --to \\\\\\\"CodeCraft/Web\\\\\\\"\\\"\\n      },\\n      {\\n        \\\"en\\\": \\\"Complete task\\\",\\n        \\\"bn\\\": \\\"টাস্ক সম্পন্ন\\\",\\n        \\\"cmd\\\": \\\"./run.sh done TSK-2026-0001 --note \\\\\\\"done\\\\\\\"\\\"\\n      },\\n      {\\n        \\\"en\\\": \\\"Validate data\\\",\\n        \\\"bn\\\": \\\"ডাটা যাচাই\\\",\\n        \\\"cmd\\\": \\\"./run.sh check\\\"\\n      },\\n      {\\n        \\\"en\\\": \\\"Emergency: restore last backup\\\",\\n        \\\"bn\\\": \\\"জরুরি: শেষ ব্যাকআপ ফেরত\\\",\\n        \\\"cmd\\\": \\\"cp data.json.bak data.json && ./run.sh check\\\"\\n      },\\n      {\\n        \\\"en\\\": \\\"Port busy? use another\\\",\\n        \\\"bn\\\": \\\"পোর্ট ব্যস্ত হলে অন্যটি\\\",\\n        \\\"cmd\\\": \\\"python3 -m http.server 8080\\\"\\n      }\\n    ],\\n    \\\"code_preview_lines\\\": 4\\n  },\\n  \\\"menu\\\": [\\n    {\\n      \\\"id\\\": \\\"dash\\\",\\n      \\\"bn\\\": \\\"ড্যাশবোর্ড\\\",\\n      \\\"en\\\": \\\"Dashboard\\\",\\n      \\\"icon\\\": \\\"◧\\\",\\n      \\\"view\\\": {\\n        \\\"type\\\": \\\"dashboard\\\"\\n      }\\n    },\\n    {\\n      \\\"id\\\": \\\"tasks\\\",\\n      \\\"bn\\\": \\\"টাস্ক\\\",\\n      \\\"en\\\": \\\"Tasks\\\",\\n      \\\"icon\\\": \\\"☑\\\",\\n      \\\"open\\\": true,\\n      \\\"view\\\": {\\n        \\\"type\\\": \\\"tasks\\\"\\n      },\\n      \\\"children\\\": [\\n        {\\n          \\\"id\\\": \\\"t-todo\\\",\\n          \\\"bn\\\": \\\"করণীয়\\\",\\n          \\\"en\\\": \\\"To do\\\",\\n          \\\"view\\\": {\\n            \\\"type\\\": \\\"tasks\\\",\\n            \\\"filter\\\": {\\n              \\\"status\\\": \\\"todo\\\"\\n            }\\n          }\\n        },\\n        {\\n          \\\"id\\\": \\\"t-doing\\\",\\n          \\\"bn\\\": \\\"চলমান\\\",\\n          \\\"en\\\": \\\"In progress\\\",\\n          \\\"view\\\": {\\n            \\\"type\\\": \\\"tasks\\\",\\n            \\\"filter\\\": {\\n              \\\"status\\\": \\\"doing\\\"\\n            }\\n          }\\n        },\\n        {\\n          \\\"id\\\": \\\"t-done\\\",\\n          \\\"bn\\\": \\\"সম্পন্ন\\\",\\n          \\\"en\\\": \\\"Done\\\",\\n          \\\"view\\\": {\\n            \\\"type\\\": \\\"tasks\\\",\\n            \\\"filter\\\": {\\n              \\\"status\\\": \\\"done\\\"\\n            }\\n          }\\n        },\\n        {\\n          \\\"id\\\": \\\"t-pri\\\",\\n          \\\"bn\\\": \\\"অগ্রাধিকার\\\",\\n          \\\"en\\\": \\\"By priority\\\",\\n          \\\"children\\\": [\\n            {\\n              \\\"id\\\": \\\"t-urgent\\\",\\n              \\\"bn\\\": \\\"জরুরি\\\",\\n              \\\"en\\\": \\\"Urgent\\\",\\n              \\\"view\\\": {\\n                \\\"type\\\": \\\"tasks\\\",\\n                \\\"filter\\\": {\\n                  \\\"priority\\\": \\\"urgent\\\"\\n                }\\n              }\\n            },\\n            {\\n              \\\"id\\\": \\\"t-high\\\",\\n              \\\"bn\\\": \\\"উচ্চ\\\",\\n              \\\"en\\\": \\\"High\\\",\\n              \\\"view\\\": {\\n                \\\"type\\\": \\\"tasks\\\",\\n                \\\"filter\\\": {\\n                  \\\"priority\\\": \\\"high\\\"\\n                }\\n              }\\n            }\\n          