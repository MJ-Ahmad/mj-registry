      "content": "{\n  \"meta\": {\n    \"title\": \"\",\n    \"subtitle_bn\": \"টাস্ক · নোট · অডিট রেজিস্ট্রি\",\n    \"subtitle_en\": \"Task · Note · Audit Registry\",\n    \"logo\": \"assets/logo.png\",\n    \"splash_ms\": 1800,\n    \"version\": \"1.2\",\n    \"footer_bn\": \"সকল তথ্য data.json থেকে লোড হয়\",\n    \"footer_en\": \"All data is loaded from data.json\",\n    \"updated_at\": \"2026-09-25T03:13:57+06:00\",\n    \"counters\": {\n      \"task\": {\n        \"2026\": 3\n      },\n      \"note\": {\n        \"2026\": 2\n      },\n      \"audit\": {\n        \"2026\": 2\n      },\n      \"code\": {\n        \"2026\": 5\n      }\n    },\n    \"tagline\": \"Where every script is a verdict, every invocation a vote, and every log a legacy.\",\n    \"links\": [\n      {\n        \"icon\": \"◈\",\n        \"en\": \"Current project\",\n        \"bn\": \"চলমান প্রজেক্ট\",\n        \"url\": \"https://MJ-Ahmad.github.io/qf\"\n      },\n      {\n        \"icon\": \"◎\",\n        \"en\": \"Website\",\n        \"bn\": \"ওয়েবসাইট\",\n        \"url\": \"https://MJ-Ahmad.github.io/mj\"\n      },\n      {\n        \"icon\": \"✉\",\n        \"en\": \"Email\",\n        \"bn\": \"ইমেইল\",\n        \"url\": \"mailto:mjahmad2024@outlook.com\"\n      },\n      {\n        \"icon\": \"•\",\n        \"en\": \"Github\",\n        \"bn\": \"গিটহাব\",\n        \"url\": \"https://github.com/MJ-Ahmad\"\n      }\n    ],\n    \"commands\": [\n      {\n        \"en\": \"Start viewer\",\n        \"bn\": \"ভিউয়ার চালু\",\n        \"cmd\": \"./run.sh serve\"\n      },\n      {\n        \"en\": \"Add task\",\n        \"bn\": \"টাস্ক যুক্ত\",\n        \"cmd\": \"./run.sh task \\\"Title\\\" --bn \\\"শিরোনাম\\\" --priority high --due 2026-12-31\"\n      },\n      {\n        \"en\": \"Add note\",\n        \"bn\": \"নোট যুক্ত\",\n        \"cmd\": \"./run.sh note \\\"Title\\\" --body \\\"...\\\" --pinned\"\n      },\n      {\n        \"en\": \"Add audit\",\n        \"bn\": \"অডিট যুক্ত\",\n        \"cmd\": \"./run.sh audit \\\"Title\\\" --result pass --related TSK-2026-0001\"\n      },\n      {\n        \"en\": \"Add code file / URL\",\n        \"bn\": \"কোড ফাইল / লিংক যুক্ত\",\n        \"cmd\": \"./run.sh code ~/mj/portal/index.html \\\"Title\\\" \\\"Description\\\" --bn \\\"শিরোনাম\\\" --bn \\\"বর্ণনা\\\"\"\n      },\n      {\n        \"en\": \"Show / manage menu tree\",\n        \"bn\": \"মেনু ট্রি দেখা / পরিচালনা\",\n        \"cmd\": \"./run.sh menu   |   ./run.sh menu --new \\\"Web/Portal\\\"   |   ./run.sh menu --move CDE-2026-0001 --to \\\"CodeCraft/Web\\\"\"\n      },\n      {\n        \"en\": \"Complete task\",\n        \"bn\": \"টাস্ক সম্পন্ন\",\n        \"cmd\": \"./run.sh done TSK-2026-0001 --note \\\"done\\\"\"\n      },\n      {\n        \"en\": \"Validate data\",\n        \"bn\": \"ডাটা যাচাই\",\n        \"cmd\": \"./run.sh check\"\n      },\n      {\n        \"en\": \"Emergency: restore last backup\",\n        \"bn\": \"জরুরি: শেষ ব্যাকআপ ফেরত\",\n        \"cmd\": \"cp data.json.bak data.json && ./run.sh check\"\n      },\n      {\n        \"en\": \"Port busy? use another\",\n        \"bn\": \"পোর্ট ব্যস্ত হলে অন্যটি\",\n        \"cmd\": \"python3 -m http.server 8080\"\n      },\n      {\n        \"en\": \"Menu tree with IDs\",\n        \"bn\": \"আইডি সহ মেনু ট্রি\",\n        \"cmd\": \"./run.sh menu\"\n      },\n      {\n        \"en\": \"Create submenu under Tools\",\n        \"bn\": \"টুলসের নিচে সাবমেনু\",\n        \"cmd\": \"./run.sh menu --new \\\"Web/Portal\\\" --bn \\\"ওয়েব/পোর্টাল\\\" --under \\\"CodeCraft/Tools\\\"\"\n      },\n      {\n        \"en\": \"Add code to existing menu\",\n        \"bn\": \"বিদ্যমান মেনুতে কোড যুক্ত\",\n        \"cmd\": \"./run.sh code ~/mj/index.html \\\"Title\\\" \\\"Description\\\" --menu \\\"CodeCraft/HTML/Portal\\\"\"\n      },\n      {\n        \"en\": \"Add code with new sub-submenu\",\n        \"bn\": \"নতুন সাব-সাবমেনুতে কোড যুক্ত\",\n        \"cmd\": \"./run.sh code ~/mj/login.html \\\"Login\\\" --menu \\\"CodeCraft/HTML\\\" --new-menu \\\"Forms/Login\\\" --new-menu-bn \\\"ফর্ম/লগইন\\\"\"\n      },\n      {\n        \"en\": \"Move code entry\",\n        \"bn\": \"কোড এন্ট্রি সরানো\",\n        \"cmd\": \"./run.sh menu --move CDE-2026-0001 --to \\\"CodeCraft/HTML/Portal\\\"\"\n      }\n    ],\n    \"code_preview_lines\": 4\n  },\n  \"menu\": [\n    {\n      \"id\": \"dash\",\n      \"bn\": \"ড্যাশবোর্ড\",\n      \"en\": \"Dashboard\",\n      \"icon\": \"◧\",\n      \"view\": {\n        \"type\": \"dashboard\"\n      }\n    },\n    {\n      \"id\": \"tasks\",\n      \"bn\": \"টাস্ক\",\n      \"en\": \"Tasks\",\n      \"icon\": \"☑\",\n      \"open\": true,\n      \"view\": {\n        \"type\": \"tasks\"\n      },\n      \"children\": [\n        {\n          \"id\": \"t-todo\",\n          \"bn\": \"করণীয়\",\n          \"en\": \"To do\",\n          \"view\": {\n            \"type\": \"tasks\",\n            \"filter\": {\n              \"status\": \"todo\"\n            }\n          }\n        },\n        {\n          \"id\": \"t-doing\",\n          \"bn\": \"চলমান\",\n          \"en\": \"In progress\",\n          \"view\": {\n            \"type\": \"tasks\",\n            \"filter\": {\n              \"status\": \"doing\"\n            }\n          }\n        },\n        {\n          \"id\": \"t-done\",\n          \"bn\": \"সম্পন্ন\",\n          \"en\": \"Done\",\n          \"view\": {\n            \"type\": \"tasks\",\n            \"filter\": {\n              \"status\": \"done\"\n            }\n          }\n        },\n        {\n          \"id\": \"t-pri\",\n          \"bn\": \"অগ্রাধিকার\",\n          \"en\": \"By priority\",\n          \"children\": [\n            {\n              \"id\": \"t-urgent\",\n              \"bn\": \"জরুরি\",\n              \"en\": \"Urgent\",\n              \"view\": {\n                \"type\": \"tasks\",\n                \"filter\": {\n                  \"priority\": \"urgent\"\n                }\n              }\n            },\n            {\n              \"id\": \"t-high\",\n              \"bn\": \"উচ্চ\",\n              \"en\": \"High\",\n              \"view\": {\n                \"type\": \"tasks\",\n                \"filter\": {\n                  \"priority\": \"high\"\n                }\n              }\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"notes\",\n      \"bn\": \"নোট\",\n      \"en\": \"Notes\",\n      \"icon\": \"✎\",\n      \"view\": {\n        \"type\": \"notes\"\n      },\n      \"children\": [\n        {\n          \"id\": \"n-pin\",\n          \"bn\": \"পিন করা\",\n          \"en\": \"Pinned\",\n          \"view\": {\n            \"type\": \"notes\",\n            \"filter\": {\n              \"pinned\": true\n            }\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"audits\",\n      \"bn\": \"অডিট\",\n      \"en\": \"Audits\",\n      \"icon\": \"⚖\",\n      \"view\": {\n        \"type\": \"audits\"\n      },\n      \"children\": [\n        {\n          \"id\": \"a-pass\",\n          \"bn\": \"উত্তীর্ণ\",\n          \"en\": \"Pass\",\n          \"view\": {\n            \"type\": \"audits\",\n            \"filter\": {\n              \"result\": \"pass\"\n            }\n          }\n        },\n        {\n          \"id\": \"a-warn\",\n          \"bn\": \"সতর্কতা\",\n          \"en\": \"Warning\",\n          \"view\": {\n            \"type\": \"audits\",\n            \"filter\": {\n              \"result\": \"warning\"\n            }\n          }\n        },\n        {\n          \"id\": \"a-fail\",\n          \"bn\": \"ব্যর্থ\",\n          \"en\": \"Fail\",\n          \"view\": {\n            \"type\": \"audits\",\n            \"filter\": {\n              \"result\": \"fail\"\n            }\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"codecraft\",\n      \"bn\": \"কোডক্রাফ্ট\",\n      \"en\": \"CodeCraft\",\n      \"icon\": \"❮❯\",\n      \"open\": true,\n      \"view\": {\n        \"type\": \"codes\"\n      },\n      \"children\": [\n        {\n          \"id\": \"c-html\",\n          \"bn\": \"MJ\",\n          \"en\": \"MJ\",\n          \"view\": {\n            \"type\": \"codes\",\n            \"filter\": {\n              \"menu_path\": \"c-html\"\n            }\n          }\n        },\n        {\n          \"id\": \"c-markdown\",\n          \"bn\": \"Registry\",\n          \"en\": \"Registry\",\n          \"view\": {\n            \"type\": \"codes\",\n            \"filter\": {\n              \"menu_path\": \"c-markdown\"\n            }\n          }\n        },\n        {\n          \"id\": \"c-mjdocs\",\n          \"bn\": \"MJDocs\",\n          \"en\": \"MJDocs\",\n          \"view\": {\n            \"type\": \"codes\",\n            \"filter\": {\n              \"menu_path\": \"c-mjdocs\"\n            }\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"registry\",\n      \"bn\": \"রেজিস্ট্রি (সব)\",\n      \"en\": \"Registry (all)\",\n      \"icon\": \"☰\",\n      \"view\": {\n        \"type\": \"all\"\n      }\n    }\n  ],\n  \"tasks\": [\n    {\n      \"id\": \"TSK-2026-0001\",\n      \"title\": \"Set up project registry\",\n      \"title_bn\": \"প্রজেক্ট রেজিস্ট্রি সেটআপ\",\n      \"desc\": \"Create index.html, data.json and scripts.\",\n      \"status\": \"done\",\n      \"priority\": \"high\",\n      \"due\": \"\",\n      \"category\": \"setup\",\n      \"tags\": [\n        \"setup\"\n      ],\n      \"created_at\": \"2026-09-24T09:00:00+06:00\",\n      \"completed_at\": \"2026-09-24T10:00:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:00:00+06:00\",\n          \"event\": \"created\"\n        },\n        {\n          \"at\": \"2026-09-24T10:00:00+06:00\",\n          \"event\": \"status → done\",\n          \"note\": \"\"\n        }\n      ]\n    },\n    {\n      \"id\": \"TSK-2026-0002\",\n      \"title\": \"Add logo to assets/\",\n      \"title_bn\": \"assets/ এ লোগো যুক্ত করুন\",\n      \"desc\": \"Place logo.png inside assets folder.\",\n      \"status\": \"todo\",\n      \"priority\": \"urgent\",\n      \"due\": \"2026-09-30\",\n      \"category\": \"setup\",\n      \"tags\": [\n        \"logo\"\n      ],\n      \"created_at\": \"2026-09-24T09:05:00+06:00\",\n      \"completed_at\": \"\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:05:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    },\n    {\n      \"id\": \"TSK-2026-0003\",\n      \"title\": \"Review weekly entries\",\n      \"title_bn\": \"সাপ্তাহিক এন্ট্রি পর্যালোচনা\",\n      \"desc\": \"\",\n      \"status\": \"doing\",\n      \"priority\": \"medium\",\n      \"due\": \"2026-10-01\",\n      \"category\": \"review\",\n      \"tags\": [\n        \"weekly\"\n      ],\n      \"created_at\": \"2026-09-24T09:10:00+06:00\",\n      \"completed_at\": \"\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:10:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    }\n  ],\n  \"notes\": [\n    {\n      \"id\": \"NOT-2026-0001\",\n      \"title\": \"How this system works\",\n      \"title_bn\": \"এই সিস্টেম যেভাবে কাজ করে\",\n      \"body\": \"index.html never changes. Add data with the scripts; the page reads data.json.\",\n      \"category\": \"guide\",\n      \"tags\": [\n        \"guide\"\n      ],\n      \"pinned\": true,\n      \"created_at\": \"2026-09-24T09:15:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T09:15:00+06:00\",\n          \"event\": \"created\"\n        }\n      ]\n    },\n    {\n      \"id\": \"NOT-2026-0002\",\n      \"title\": \"ID format\",\n      \"title_bn\": \"আইডি ফরম্যাট\",\n      \"body\": \"TSK / NOT / AUD + year + serial. IDs are never reused.\",\n      \"category\": \"guide\",\n      \"tags\": [\n        \"id\"\n      ],\n      \"pinned\": false,\n      \"created_at\": \"2026-09-24T09:20:00+06:00\",\n      \"history\": [\n        {\n          \"at\": \"2026-09-24T0