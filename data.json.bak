      "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>MJSovereign | Loading...</title>\n  <link rel=\"stylesheet\" href=\"css/style.css\" />\n  <style>\n    /* Splash overlay styles */\n    body {\n      margin: 0;\n      font-family: Arial, sans-serif;\n    }\n    #splash {\n      position: fixed;\n      top: 0; left: 0;\n      width: 100%; height: 100%;\n      background: linear-gradient(135deg, #0f2027, #203a43, #2c5364);\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      flex-direction: column;\n      z-index: 9999;\n      color: #fff;\n    }\n    #splash img {\n      width: 180px;\n      animation: fadeIn 2s ease-in-out;\n    }\n    .progress-bar {\n      width: 300px;\n      height: 10px;\n      background: rgba(255,255,255,0.2);\n      border-radius: 5px;\n      margin: 20px auto;\n      overflow: hidden;\n    }\n    .progress {\n      height: 100%;\n      width: 0;\n      background: #00ffcc;\n      transition: width 0.3s ease;\n    }\n    .loading-text {\n      margin-top: 15px;\n      font-size: 1.1em;\n      animation: pulse 1.5s infinite;\n    }\n    @keyframes fadeIn {\n      from { opacity: 0; transform: scale(0.8); }\n      to { opacity: 1; transform: scale(1); }\n    }\n    @keyframes pulse {\n      0% { opacity: 0.5; }\n      50% { opacity: 1; }\n      100% { opacity: 0.5; }\n    }\n  </style>\n</head>\n<body>\n  <!-- Splash overlay -->\n  <div id=\"splash\">\n    <img src=\"logo.png\" alt=\"MJSovereign Logo\">\n    <div class=\"progress-bar\"><div class=\"progress\"></div></div>\n    <p class=\"loading-text\">Preparing your sovereign experience...</p>\n  </div>\n\n  <!-- Splash script -->\n  <script>\n    let progress = document.querySelector(\".progress\");\n    let width = 0;\n    let interval = setInterval(() => {\n      if (width >= 100) {\n        clearInterval(interval);\n        // Redirect to home.html after splash\n        window.location.href = \"home.html\";\n      } else {\n        width++;\n        progress.style.width = width + \"%\";\n      }\n    }, 30); // 3 seconds total\n  </script>\n</body>\n</html>\n",
      "menu_path": [
        "codecraft",
        "c-html"
      ]
    },
