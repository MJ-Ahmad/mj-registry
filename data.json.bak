    "commands": [
      {
        "en": "Start viewer",
        "bn": "ভিউয়ার চালু",
        "cmd": "./run.sh serve"
      },
      {
        "en": "Add task",
        "bn": "টাস্ক যুক্ত",
        "cmd": "./run.sh task \"Title\" --bn \"শিরোনাম\" --priority high --due 2026-12-31"
      },
      {
        "en": "Add note",
        "bn": "নোট যুক্ত",
        "cmd": "./run.sh note \"Title\" --body \"...\" --pinned"
      },
      {
        "en": "Add audit",
        "bn": "অডিট যুক্ত",
        "cmd": "./run.sh audit \"Title\" --result pass --related TSK-2026-0001"
      },
      {
        "en": "Add code file / URL",
        "bn": "কোড ফাইল / লিংক যুক্ত",
        "cmd": "./run.sh code ~/mj/portal/index.html \"Title\" \"Description\" --bn \"শিরোনাম\" --bn \"বর্ণনা\""
      },
      {
        "en": "Show / manage menu tree",
        "bn": "মেনু ট্রি দেখা / পরিচালনা",
        "cmd": "./run.sh menu   |   ./run.sh menu --new \"Web/Portal\"   |   ./run.sh menu --move CDE-2026-0001 --to \"CodeCraft/Web\""
      },
      {
        "en": "Complete task",
        "bn": "টাস্ক সম্পন্ন",
        "cmd": "./run.sh done TSK-2026-0001 --note \"done\""
      },
      {
        "en": "Validate data",
        "bn": "ডাটা যাচাই",
        "cmd": "./run.sh check"
      },
      {
        "en": "Emergency: restore last backup",
        "bn": "জরুরি: শেষ ব্যাকআপ ফেরত",
        "cmd": "cp data.json.bak data.json && ./run.sh check"
      },
      {
        "en": "Port busy? use another",
        "bn": "পোর্ট ব্যস্ত হলে অন্যটি",
        "cmd": "python3 -m http.server 8080"
      },
      {
        "en": "Menu tree with IDs",
        "bn": "আইডি সহ মেনু ট্রি",
        "cmd": "./run.sh menu"
      },
      {
        "en": "Create submenu under Tools",
        "bn": "টুলসের নিচে সাবমেনু",
        "cmd": "./run.sh menu --new \"Web/Portal\" --bn \"ওয়েব/পোর্টাল\" --under \"CodeCraft/Tools\""
      },
      {
        "en": "Add code to existing menu",
        "bn": "বিদ্যমান মেনুতে কোড যুক্ত",
        "cmd": "./run.sh code ~/mj/index.html \"Title\" \"Description\" --menu \"CodeCraft/HTML/Portal\""
      },
      {
        "en": "Add code with new sub-submenu",
        "bn": "নতুন সাব-সাবমেনুতে কোড যুক্ত",
        "cmd": "./run.sh code ~/mj/login.html \"Login\" --menu \"CodeCraft/HTML\" --new-menu \"Forms/Login\" --new-menu-bn \"ফর্ম/লগইন\""
      },
      {
        "en": "Move code entry",
        "bn": "কোড এন্ট্রি সরানো",
        "cmd": "./run.sh menu --move CDE-2026-0001 --to \"CodeCraft/HTML/Portal\""
      }
    ],
    "code_preview_lines": 4
  },
