run.sh task \\\"Title\\\" --bn \\\"শিরোনাম\\\" --priority high --due 2026-12-31\"\n      },\n      {\n        \"en\": \"Add note\",\n        \"bn\": \"নোট যুক্ত\",\n        \"cmd\": \"./run.sh note \\\"Title\\\" --body \\\"...\\\" --pinned\"\n      },\n      {\n        \"en\": \"Add audit\",\n        \"bn\": \"অডিট যুক্ত\",\n        \"cmd\": \"./run.sh audit \\\"Title\\\" --result pass --related TSK-2026-0001\"\n      },\n      {\n        \"en\": \"Add code file / URL\",\n        \"bn\": \"কোড ফাইল / লিংক যুক্ত\",\n        \"cmd\": \"./run.sh code ~/mj/portal/index.html \\\"Title\\\" \\\"Description\\\" --bn \\\"শিরোনাম\\\" --bn \\\"বর্ণনা\\\"\"\n      },\n      {\n        \"en\": \"Show / manage menu tree\",\n        \"bn\": \"মেনু ট্রি দেখা / পরিচালনা\",\n        \"cmd\": \"./run.sh menu   |   ./run.sh menu --new \\\"Web/Portal\\\"   |   ./run.sh menu --move CDE-2026-0001 --to \\\"CodeCraft/Web\\\"\"\n      },\n      {\n        \"en\": \"Complete task\",\n        \"bn\": \"টাস্ক সম্পন্ন\",\n        \"cmd\": \"./run.sh done TSK-2026-0001 --note \\\"done\\\"\"\n      },\n      {\n        \"en\": \"Validate data\",\n        \"bn\": \"ডাটা যাচাই\",\n        \"cmd\": \"./run.sh check\"\n      },\n      {\n        \"en\": \"Emergency: restore last backup\",\n        \"bn\": \"জরুরি: শেষ ব্যাকআপ ফেরত\",\n        \"cmd\": \"cp data.json.bak data.json && ./run.sh check\"\n      },\n      {\n        \"en\": \"Port busy? use another\",\n        \"bn\": \"পোর্ট ব্যস্ত হলে অন্যটি\",\n        \"cmd\": \"python3 -m http.server 8080\"\n      }\n    ],\n    \"code_preview_lines\": 4\n  },\n  \"menu\": [\n    {\n      \"id\": \"dash\",\n      \"bn\": \"ড্যাশবোর্ড\",\n      \"en\": \"Dashboard\",\n      \"icon\": \"◧\",\n      \"view\": {\n        \"type\": \"dashboard\"\n      }\n    },\n    {\n      \"id\": \"tasks\",\n      \"bn\": \"টাস্ক\",\n      \"en\": \"Tasks\",\n      \"icon\": \"☑\",\n      \"open\": true,\n      \"view\": {\n        \"type\": \"tasks\"\n      },\n      \