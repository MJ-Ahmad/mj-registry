    "commands": [
      {
        "group": "code",
        "en": "Open viewer",
        "bn": "ভিউয়ার চালু",
        "cmd": "./run.sh serve"
      },
      {
        "group": "code",
        "en": "Add a code file / URL",
        "bn": "কোড ফাইল / লিংক যুক্ত",
        "cmd": "./run.sh code ~/mj/portal/index.html \"Title\" \"Description\" --bn \"শিরোনাম\" --bn \"বর্ণনা\""
      },
      {
        "group": "code",
        "en": "Import a whole directory",
        "bn": "পুরো ডিরেক্টরি যুক্ত",
        "cmd": "./run.sh codedir ~/mj/portal --menu \"CodeCraft/Web\""
      },
      {
        "group": "audit",
        "en": "Add an audit",
        "bn": "অডিট যুক্ত",
        "cmd": "./run.sh audit \"Title\" --result pass --related CDE-2026-0001"
      },
      {
        "group": "menu",
        "en": "Show the menu tree",
        "bn": "মেনু ট্রি দেখুন",
        "cmd": "./run.sh menu"
      },
      {
        "group": "menu",
        "en": "Create a submenu",
        "bn": "সাবমেনু তৈরি",
        "cmd": "./run.sh menu --new \"Web/Portal\" --bn \"ওয়েব/পোর্টাল\" --under \"CodeCraft\""
      },
      {
        "group": "menu",
        "en": "Move an entry",
        "bn": "এন্ট্রি সরান",
        "cmd": "./run.sh menu --move CDE-2026-0001 --to \"CodeCraft/Web/Portal\""
      },
      {
        "group": "data",
        "en": "Validate data",
        "bn": "ডাটা যাচাই",
        "cmd": "./run.sh check"
      },
      {
        "group": "data",
        "en": "Backup now",
        "bn": "ব্যাকআপ নিন",
        "cmd": "./backup.sh"
      },
      {
        "group": "data",
        "en": "Emergency: restore last backup",
        "bn": "জরুরি: শেষ ব্যাকআপ ফেরত",
        "cmd": "cp data.json.bak data.json && ./run.sh check"
      },
      {
        "group": "data",
        "en": "Emergency: restore a dated backup",
        "bn": "জরুরি: নির্দিষ্ট তারিখের ব্যাকআপ ফেরত",
        "cmd": "./backup.sh --restore backups/backup-....zip"
      },
      {
        "group": "server",
        "en": "Port busy? use another",
        "bn": "পোর্ট ব্যস্ত হলে অন্যটি",
        "cmd": "python3 -m http.server 8080"
      }
